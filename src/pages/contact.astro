---
import Cursor from '../components/Cursor.astro';
import DoodleIcon from '../components/DoodleIcon.astro';
import Meadow from '../components/Meadow.astro';
import SiteNav from '../components/SiteNav.astro';
import Layout from '../layouts/Layout.astro';
import { contactLinks } from '../data/portfolio';

const email = contactLinks.find((l) => l.label === 'Email')!.url;
const address = email.replace('mailto:', '');
const topics = [
	{ label: 'A role', subject: 'About a frontend role' },
	{ label: 'A project', subject: 'About a project' },
	{ label: 'Just saying hi', subject: 'Saying hi' },
];
// Each card's paper is inked three times, one per still frame of the boil (doodle-frame-1..3 in the layout).
const frames = [0, 1, 2];
---

<Layout title="Contact — Phi Hung" page="contact">
	<main class="scene">
		<SiteNav current="contact" />
		<section class="contact" aria-labelledby="contact-title">
			<div class="note">
				{frames.map((n) => <span class="boil" style={`--f: ${n}; --frame: url(#doodle-frame-${n + 1})`} aria-hidden="true" />)}
				<span class="plane" aria-hidden="true">
					<svg class="plane-art" viewBox="-46 -17 74 34" fill="none" stroke="#17130f" stroke-linecap="round" stroke-linejoin="round">
						<path d="M-21 2.5c-6 .6-11 2.4-16 5.6M-41 10.6l-2.6 1.8" stroke-width="1.1" stroke-dasharray="3.2 3.6" opacity="0.55" />
						<path d="M25 0-13 10.5-9.5 2.6z" fill="#e6dccb" stroke-width="1.25" />
						<path d="M-6.5 6.3 3 3.4M-9.8 8.4.4 5.3M-3 4.2 5.6 1.8" stroke-width="0.7" opacity="0.6" />
						<path d="M25 0-16-13-9.5 2.6z" fill="#fbf7ef" stroke-width="1.25" />
						<path d="M25 0-12 1.1" stroke-width="0.9" />
						<path d="M-9.5 2.6-14 4.2-13 10.5" stroke-width="1.25" />
					</svg>
				</span>
				<span class="tape tape-l" aria-hidden="true"></span>
				<span class="tape tape-r" aria-hidden="true"></span>
				<div class="hello">
					<h1 class="t-sheet" id="contact-title">Say hello</h1>
					<p class="lead">Open to frontend roles, remote or in Vietnam.</p>
					<a class="pill pill-solid mail" href={email}>
						<DoodleIcon name="email" />
						{address}
					</a>
					<div class="meta-row">
						<button type="button" class="pill t-label copy" data-copy={address} aria-label={`Copy ${address}`}>
							<DoodleIcon name="copy" />
							<span data-copy-label>Copy</span>
						</button>
						<p class="clock">
							It's <time data-clock>--:--</time> in Ho Chi Minh City (UTC+7).
						</p>
					</div>
					<p class="sr-only" aria-live="polite" data-copy-status></p>
				</div>

				<form class="compose" data-compose data-to={address}>
					{frames.map((n) => <span class="boil" style={`--f: ${n}; --frame: url(#doodle-frame-${n + 1})`} aria-hidden="true" />)}
					<h2 class="compose-title">Or write it here</h2>
					<fieldset class="topics">
						<legend>It's about</legend>
						{
							topics.map((t, k) => (
								<label class="topic">
									<input type="radio" name="topic" value={t.subject} checked={k === 0} />
									<span class="pill">{t.label}</span>
								</label>
							))
						}
					</fieldset>
					<label class="field">
						<span>Your name</span>
						<span class="well"><input name="name" autocomplete="name" /></span>
					</label>
					<label class="field">
						<span>Message</span>
						<span class="well"><textarea name="message" rows="3" required></textarea></span>
					</label>
					<button type="submit" class="pill pill-solid t-label send">Open in my email app</button>
					<p class="fine">Nothing is sent from this site. It opens your email app with this filled in.</p>
				</form>
			</div>
		</section>
		<Meadow />
		<Cursor />
	</main>
</Layout>

<script>
	import '../scripts/page';

	const clock = document.querySelector<HTMLTimeElement>('[data-clock]')!;
	const time = new Intl.DateTimeFormat('en-GB', {
		timeZone: 'Asia/Ho_Chi_Minh',
		hour: '2-digit',
		minute: '2-digit',
		hour12: false,
	});
	const tick = () => (clock.textContent = time.format(new Date()));
	tick();
	setInterval(tick, 15000);

	const copy = document.querySelector<HTMLButtonElement>('[data-copy]')!;
	const copyLabel = copy.querySelector<HTMLElement>('[data-copy-label]')!;
	const status = document.querySelector<HTMLElement>('[data-copy-status]')!;
	let copyTimer = 0;
	copy.addEventListener('click', async () => {
		const text = copy.dataset.copy!;
		try {
			await navigator.clipboard.writeText(text);
		} catch {
			const field = Object.assign(document.createElement('textarea'), { value: text });
			document.body.append(field);
			field.select();
			document.execCommand('copy');
			field.remove();
		}
		copyLabel.textContent = 'Copied!';
		status.textContent = `${text} copied`;
		clearTimeout(copyTimer);
		copyTimer = window.setTimeout(() => {
			copyLabel.textContent = 'Copy';
			status.textContent = '';
		}, 1800);
	});

	const form = document.querySelector<HTMLFormElement>('[data-compose]')!;
	form.addEventListener('submit', (e) => {
		e.preventDefault();
		const data = new FormData(form);
		const name = String(data.get('name') ?? '').trim();
		const message = String(data.get('message') ?? '').trim();
		const subject = `${data.get('topic')}${name ? ` (from ${name})` : ''}`;
		const body = name ? `${message}\n\n${name}` : message;
		location.href = `mailto:${form.dataset.to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
	});
</script>

<style>
	.scene {
		position: relative;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	/* A card's paper and inked edge sit under its text, so the text stays crisp. The card is too big to
	   re-filter eight times a second, so it is three copies, each filtered once with a still frame of the
	   character's boil, and only which copy shows changes (an opacity step on the compositor, as in the
	   meadow). */
	.boil {
		position: absolute;
		inset: calc(var(--line) * -1);
		z-index: -1;
		border-radius: inherit;
		pointer-events: none;
		will-change: opacity;
		animation: card-boil 0.375s steps(1) calc(var(--f) * -0.125s) infinite;
	}

	.boil + .boil {
		opacity: 0;
	}

	.boil::before {
		content: '';
		position: absolute;
		inset: 0;
		border: var(--line) solid var(--color-ink);
		border-radius: inherit;
		background: var(--paper);
		box-shadow: var(--ink-shadow, none);
		filter: var(--frame);
	}

	/* A hair over a third, so a step never falls between two copies and shows no paper. */
	@keyframes card-boil {
		0% {
			opacity: 1;
		}
		33.4%,
		100% {
			opacity: 0;
		}
	}

	/* Touch screens and reduced motion keep the first inking, still wobbly. */
	@media (pointer: coarse), (prefers-reduced-motion: reduce) {
		.boil {
			animation: none;
			will-change: auto;
		}

		.boil + .boil {
			display: none;
		}
	}

	.contact {
		position: relative;
		z-index: 7;
		flex: 1;
		display: grid;
		place-items: center;
		padding: 1.25rem clamp(1rem, 3vw, 2.5rem) 12vh;
	}

	.note {
		--line: 2.5px;
		--paper: #fbf7ef;
		position: relative;
		z-index: 2;
		width: min(100%, 60rem);
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 3vw, 2.75rem);
		align-items: center;
		padding: clamp(1.5rem, 3.5vh, 2.5rem) clamp(1.5rem, 3.5vw, 2.75rem);
		border: 2.5px solid transparent;
		border-radius: 6px 14px 8px 12px / 12px 6px 14px 8px;
		box-shadow: 0 18px 40px -24px rgb(23 19 15 / 0.45);
		rotate: -1deg;
	}

	.tape {
		position: absolute;
		top: -0.8rem;
		width: 4.5rem;
		height: 1.5rem;
		background: var(--tape);
		filter: url(#doodle-frame-1);
		animation: var(--ink-boil);
	}

	.tape-r {
		animation-delay: -0.125s;
	}

	.tape-l {
		left: 1.5rem;
		rotate: -10deg;
	}

	.tape-r {
		right: 1.5rem;
		rotate: 8deg;
	}

	.lead {
		margin-top: 0.75rem;
		font-size: var(--text-lead);
		color: var(--color-ash);
	}

	.mail {
		margin-top: 1.5rem;
		font-size: var(--text-body);
		font-weight: 700;
		padding: 0.9em 1.4em;
	}

	.meta-row {
		margin-top: 1rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 1rem;
	}

	.copy {
		padding: 0.55em 1em;
	}

	.copy :global(.doodle-icon) {
		width: 1rem;
		height: 1rem;
	}

	.clock {
		font-size: var(--text-small);
		color: var(--color-ash);
	}

	.clock time {
		font-weight: 800;
		color: var(--color-ink);
	}

	/* The compose card: ruled like a notepad page */
	.compose {
		--line: 2px;
		--paper: #fff;
		--ink-shadow: 3px 4px 0 var(--color-ink);
		position: relative;
		isolation: isolate;
		display: grid;
		gap: 0.7rem;
		padding: 1.1rem 1.25rem 1rem;
		border: 2px solid transparent;
		border-radius: 4px 9px 5px 10px / 9px 4px 10px 5px;
		rotate: 1.4deg;
	}

	.compose-title {
		font-size: 1.25rem;
		font-weight: 800;
		line-height: 1.1;
	}

	.topics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		border: 0;
	}

	.topics legend,
	.field > span:not(.well) {
		margin-bottom: 0.35rem;
		font-size: var(--text-label);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.topic .pill {
		padding: 0.45em 0.95em;
		font-size: var(--text-small);
	}

	.topic input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.topic input:checked + .pill {
		background: var(--color-ink);
		color: var(--color-paper);
	}

	.topic input:focus-visible + .pill {
		outline: 2px solid var(--color-ink);
		outline-offset: 3px;
	}

	.field {
		display: grid;
	}

	/* The field's inked outline is drawn over it on its own layer; the control itself is never filtered. */
	.well {
		position: relative;
		display: grid;
	}

	.well::after {
		content: '';
		position: absolute;
		inset: 0;
		border: 2px solid var(--color-ink);
		border-radius: 4px 7px 5px 8px / 7px 4px 8px 5px;
		filter: url(#doodle-frame-1);
		animation: var(--ink-boil);
		pointer-events: none;
	}

	.field + .field .well::after {
		border-radius: 7px 4px 8px 5px / 4px 8px 5px 7px;
		animation-delay: -0.25s;
	}

	.field input,
	.field textarea {
		width: 100%;
		padding: 0.5rem 0.7rem;
		border: 2px solid transparent;
		border-radius: 4px 7px 5px 8px / 7px 4px 8px 5px;
		background: #fbf7ef;
		font: inherit;
		font-size: var(--text-body);
		color: var(--color-ink);
	}

	.field textarea {
		resize: vertical;
		min-height: 5.3rem;
		line-height: 1.6rem;
		background: repeating-linear-gradient(
			#fbf7ef 0 calc(1.6rem - 1px),
			rgb(122 166 217 / 0.45) calc(1.6rem - 1px) 1.6rem
		);
		background-position: 0 0.5rem;
		background-attachment: local;
	}

	.field input:focus-visible,
	.field textarea:focus-visible {
		outline: 2px solid var(--color-amber-deep);
		outline-offset: 2px;
	}

	.send {
		justify-self: start;
	}

	.fine {
		font-size: var(--text-label);
		color: var(--color-ash);
	}

	/* A paper plane circles the note on a closed loop, so it never jumps back to a start. It flies behind
	   the paper, ducking out of sight at the corners, and keeps clear of the words. */
	.plane {
		position: absolute;
		top: 0;
		left: 0;
		z-index: -2;
		width: 9.25rem;
		offset-path: ellipse(57% 68% at 50% 50%);
		offset-anchor: 69% 50%;
		offset-rotate: auto;
		/* Where it rests when motion is reduced: up and to the right, in view on any desktop. */
		offset-distance: 82%;
		pointer-events: none;
		will-change: transform;
		animation: plane-orbit 20s linear infinite;
	}

	.plane-art {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
		filter: url(#doodle-frame-1);
		animation: var(--ink-boil);
	}

	@keyframes plane-orbit {
		from {
			offset-distance: 0%;
		}
		to {
			offset-distance: 100%;
		}
	}

	/* Reduced motion: the plane rests on its trail. */
	@media (prefers-reduced-motion: reduce) {
		.plane {
			animation: none;
		}
	}

	@media (max-width: 767px) {
		.note {
			grid-template-columns: 1fr;
			text-align: left;
		}

		.compose {
			rotate: 0.6deg;
		}

		/* On a phone the note is tall: the loop swings out under it, over the meadow. */
		.plane {
			width: 7rem;
			offset-path: ellipse(54% 54% at 50% 56%);
			offset-distance: 25%;
		}
	}
</style>
