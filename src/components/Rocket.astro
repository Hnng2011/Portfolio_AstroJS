---
// The rocket his work flies in: a chunky cartoon, inked by hand with hatch shading down its shadow side.
// Origin at the ground below its centre, y grows downwards; about 570 tall in the character's units.
import { COLORS as C } from '../lib/hung';
import { ROCKET } from '../lib/launch';
import HeadFront from './HeadFront.astro';

const HULL = '#fbf7ef';
const PANEL = '#f3ecdf';
const CORAL = '#ef8f6f';
const CORAL_DEEP = '#cf6e52';
const METAL = '#d6cdbf';
const DARK = '#3d3731';
const GLASS = '#7aa6d9';
const INSIDE = '#2a2420';
const { door: D, port: P, nozzle: N } = ROCKET;

const hull = 'M0 -568C42 -558 88 -500 100 -400C110 -318 102 -200 76 -118H-76C-102 -200-110 -318-100 -400C-88 -500-42 -558 0 -568Z';
const door = `M${D.x0} ${D.sill}V${D.top + D.r}C${D.x0} ${D.top + 12}-22 ${D.top} 0 ${D.top}C22 ${D.top} ${D.x1} ${D.top + 12} ${D.x1} ${D.top + D.r}V${D.sill}Z`;
const fin = 'M-88 -262C-132 -240-170 -170-174 -62C-175 -32-167 -8-150 -6C-137 -5-130 -14-128 -32C-124 -72-106 -104-76 -120Z';
---

<svg
	class="rocket-art"
	viewBox="-200 -600 400 700"
	fill="none"
	stroke={C.ink}
	stroke-width="3.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	<defs>
		<clipPath id="rocket-hull"><path d={hull} /></clipPath>
		<clipPath id="rocket-door"><path d={door} /></clipPath>
		<clipPath id="rocket-port"><circle cx="0" cy={P.y} r={P.r} /></clipPath>
	</defs>

	<g class="speed" aria-hidden="true" style="pointer-events: none">
		<path d="M-122 -530V-250M126 -500V-270M-160 -430V-170M164 -400V-150M-140 -250V-40M146 -220V-20" stroke-width="3" />
	</g>

	<g data-flame style="opacity: 0; pointer-events: none">
		<g data-flame-shape>
			<path
				d={`M-42 ${N}C-50 ${N + 44}-34 ${N + 86}-24 ${N + 116}C-18 ${N + 96}-10 ${N + 90} 0 ${N + 150}C10 ${N + 90} 18 ${N + 96} 24 ${N + 116}C34 ${N + 86} 50 ${N + 44} 42 ${N}Z`}
				fill="#f2a541"
			/>
			<path data-flicker="0" d={`M-26 ${N}C-30 ${N + 34}-16 ${N + 64} 0 ${N + 96}C16 ${N + 64} 30 ${N + 34} 26 ${N}Z`} fill={HULL} stroke-width="3" />
			<path
				data-flicker="1"
				d={`M-26 ${N}C-32 ${N + 40}-12 ${N + 70} 2 ${N + 88}C16 ${N + 56} 28 ${N + 30} 26 ${N}Z`}
				fill={HULL}
				stroke-width="3"
				style="display: none"
			/>
			<path
				data-flicker="2"
				d={`M-26 ${N}C-26 ${N + 30}-18 ${N + 60}-2 ${N + 92}C12 ${N + 66} 32 ${N + 36} 26 ${N}Z`}
				fill={HULL}
				stroke-width="3"
				style="display: none"
			/>
			<path d={`M-54 ${N + 70}l-12 16M54 ${N + 70}l12 16M-34 ${N + 128}l-6 16M34 ${N + 128}l6 16`} stroke-width="3" />
		</g>
	</g>

	<path d={fin} fill={CORAL} />
	<path d={fin} fill={CORAL} transform="scale(-1 1)" />
	<path d="M-156 -40q2 -60 30 -120M156 -40q-2 -60-30 -120" stroke={CORAL_DEEP} stroke-width="6" />

	<path d={`M-36 -120L-46 ${N}C-20 ${N + 6} 20 ${N + 6} 46 ${N}L36 -120Z`} fill={DARK} />
	<path d={`M-42 ${N - 8}C-16 ${N - 3} 16 ${N - 3} 42 ${N - 8}`} stroke="#8a8178" stroke-width="2.6" />

	<path d={hull} fill={HULL} />
	<g clip-path="url(#rocket-hull)">
		<path d="M-120 -600H120V-470C60 -452-60 -452-120 -470Z" fill={CORAL} />
		<path d="M-120 -214C-60 -198 60 -198 120 -214V-196C60 -180-60 -180-120 -196Z" fill={CORAL} />
		<path d="M-74 -440C-86 -360-86 -240-72 -150" stroke="#fff" stroke-width="9" opacity="0.8" />
		<path d="M-34 -540q-18 16-28 52" stroke="#fff" stroke-width="7" opacity="0.6" />
		{
			Array.from({ length: 24 }, (_, k) => {
				const y = -540 + k * 18;
				return <path d={`M${60 + (k % 3) * 3} ${y + 16}l34 -28`} stroke-width="2.2" opacity="0.42" />;
			})
		}
		<path d="M-120 -470C-60 -452 60 -452 120 -470" stroke-width="3" />
		<path d="M-120 -214C-60 -198 60 -198 120 -214M-120 -196C-60 -180 60 -180 120 -196" stroke-width="2.6" />
		{[-64, -32, 32, 64].map((x) => <circle cx={x} cy={-453 - Math.abs(x) * 0.12} r="2.6" fill={C.ink} stroke="none" />)}
	</g>
	<path d={hull} />

	<g data-port>
		<circle class="focus-ring" cx="0" cy={P.y} r={P.r + 24} stroke="#8a5512" stroke-width="4" stroke-dasharray="9 9" opacity="0" style="pointer-events: none" />
		<circle cx="0" cy={P.y} r={P.r + 11} fill={METAL} />
		<circle cx="0" cy={P.y} r={P.r} fill={INSIDE} />
		<g clip-path="url(#rocket-port)">
			<g data-port-face style="opacity: 0" transform={`translate(0 ${P.face}) scale(${P.scale})`}>
				<g stroke={C.ink} stroke-width="3.6">
					<path d="M-70 60C-68 6-40 -12 0 -12C40 -12 68 6 70 60Z" fill={C.tee} />
					<HeadFront />
				</g>
			</g>
			<g data-port-thumb style="opacity: 0" transform={`translate(${P.thumb.x} ${P.thumb.y})`}>
				<path d="M-9 0C-11 -9-7 -13 0 -13H7C13 -13 15 -4 11 0V11C11 18 5 20-2 20C-9 20-11 13-9 7Z" fill={C.skin} stroke-width="2.8" />
				<path d="M-2 -13C-4 -24 0 -33 6 -31C9 -29 8 -20 7 -13" fill={C.skin} stroke-width="2.8" />
			</g>
			<circle cx="0" cy={P.y} r={P.r} fill={GLASS} stroke="none" opacity="0.22" />
			<path d={`M-24 ${P.y - 20}q10 -13 26 -15M-29 ${P.y - 3}q1 -5 4 -9`} stroke="#fff" stroke-width="5" opacity="0.75" />
		</g>
		<circle cx="0" cy={P.y} r={P.r} />
		<circle cx="0" cy={P.y} r={P.r + 11} />
		{
			Array.from({ length: 6 }, (_, k) => {
				const a = (k / 6) * Math.PI * 2 + 0.5;
				return <circle cx={Math.cos(a) * (P.r + 5.5)} cy={P.y + Math.sin(a) * (P.r + 5.5)} r="2.6" fill={C.ink} stroke="none" />;
			})
		}
	</g>

	<g data-door>
		<path d={door} fill={INSIDE} />
		<g clip-path="url(#rocket-door)">
			<path d={`M${D.x0} ${D.sill}V${D.sill - 44}C-14 ${D.sill - 54} 14 ${D.sill - 54} ${D.x1} ${D.sill - 44}V${D.sill}Z`} fill="#3a332d" stroke="none" />
			<g data-door-panel>
				<path d={door} fill={PANEL} />
				<path d={`M${D.x0 + 9} ${D.sill - 8}V${D.top + D.r}C${D.x0 + 9} ${D.top + 20}-16 ${D.top + 9} 0 ${D.top + 9}C16 ${D.top + 9} ${D.x1 - 9} ${D.top + 20} ${D.x1 - 9} ${D.top + D.r}V${D.sill - 8}Z`} stroke-width="2.2" opacity="0.5" />
				<rect x={D.x1 - 17} y={D.sill - 96} width="9" height="28" rx="4.5" fill={METAL} stroke-width="2.8" />
				<g transform={`rotate(-5 0 ${D.sill - 112})`}>
					<rect x="-37" y={D.sill - 130} width="74" height="34" rx="3" fill="#fffdf8" stroke-width="2.8" />
					<text
						x="0"
						y={D.sill - 107}
						text-anchor="middle"
						fill={C.ink}
						stroke="none"
						font-family="Shantell Sans, Comic Sans MS, sans-serif"
						font-size="14"
						font-weight="800">my work</text
					>
					<g transform={`rotate(6 0 ${D.sill - 132}) translate(-14 ${D.sill - 139}) scale(0.28 0.42)`}>
						<path d="M3 2.5 97 3.5 94 7.5 99 11 95 15 100 19 95.5 23 98 27.5 2 26.5 5.5 23 .5 19 4.5 15 0 11 4 7.5Z" fill="#f2a541" opacity="0.88" stroke="none" />
						<path d="M6 8.5 94 9.5" stroke="#fff" stroke-opacity="0.4" stroke-width="3" vector-effect="non-scaling-stroke" />
						<path d="M3 2.5 97 3.5M2 26.5 98 27.5" stroke-width="1.6" vector-effect="non-scaling-stroke" />
					</g>
				</g>
			</g>
		</g>
		<path d={door} stroke-width="4" />
	</g>

	<g data-stairs>
		<path d={`M-34 ${D.sill + 2}L-44 -2M34 ${D.sill + 2}L44 -2`} stroke-width="9" />
		<path d={`M-34 ${D.sill + 2}L-44 -2M34 ${D.sill + 2}L44 -2`} stroke={METAL} stroke-width="3.4" />
		{ROCKET.treads.slice(0, 2).map((y, k) => <rect x={-40 - k * 3} y={y} width={80 + k * 6} height="10" rx="3" fill={METAL} stroke-width="3" />)}
	</g>
</svg>

<style>
	.speed {
		opacity: 0;
		transition: opacity 0.6s var(--ease-out);
	}

	/* Air streaming past while it flies; paused (and invisible) on the pad. */
	.speed path {
		stroke-dasharray: 34 120;
		animation: rush 0.42s linear infinite paused;
	}

	:global(.is-flying) .speed {
		opacity: 0.5;
	}

	:global(.is-flying) .speed path {
		animation-play-state: running;
	}

	@keyframes rush {
		to {
			stroke-dashoffset: -154;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.speed path {
			animation: none;
		}
	}
</style>
