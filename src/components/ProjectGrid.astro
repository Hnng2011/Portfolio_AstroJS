---
import { projects } from '../data/portfolio';
import work01 from '../assets/work-01.svg';
import work02 from '../assets/work-02.svg';
import work03 from '../assets/work-03.svg';
import work04 from '../assets/work-04.svg';
import work05 from '../assets/work-05.svg';
import work06 from '../assets/work-06.svg';
import work07 from '../assets/work-07.svg';

const thumbs: Record<string, string> = {
	'01': work01.src,
	'02': work02.src,
	'03': work03.src,
	'04': work04.src,
	'05': work05.src,
	'06': work06.src,
	'07': work07.src,
};

const tagPool = new Set(projects.flatMap((project) => project.tags));
const preferred = ['React', 'Next.js', 'Astro', 'Remix', 'DApp', 'Supabase', 'Testing'];
const filterTags = ['All', ...preferred.filter((tag) => tagPool.has(tag))].slice(0, 8);
---

<section id="work" class="tone-light text-ink">
	<div class="swiss-container py-24 lg:py-32">
		<div class="grid gap-8 lg:grid-cols-12 lg:gap-6">
			<div class="lg:col-span-4">
				<p class="font-mono text-sm text-ink-faint">02 —</p>
				<p class="t-label mt-3 text-ink">Selected work</p>
				<div class="hairline-t mt-5 w-16 text-ink/30"></div>
			</div>
			<div class="lg:col-span-8">
				<h2 class="t-headline">
					Real<br /><span class="stroke-title text-ink">project</span> work.
				</h2>
				<p class="mt-5 font-mono text-xs uppercase tracking-[0.2em] text-ink-faint">
					{String(projects.length).padStart(2, '0')} projects / expand for case study
				</p>
			</div>
		</div>

		<div
			class="mt-12 flex flex-wrap gap-3 lg:mt-16"
			role="group"
			aria-label="Filter projects by technology"
		>
			{
				filterTags.map((tag, i) => (
					<button
						type="button"
						data-filter={tag}
						aria-pressed={i === 0 ? 'true' : 'false'}
						class:list={[
							't-label rounded-panel px-4 py-2 transition-colors duration-300 ease-glass focus-visible:ring-2 focus-visible:ring-accent',
							i === 0 ? 'bg-ink text-paper' : 'glass-light text-ink-soft hover:text-ink',
						]}
					>
						{tag}
					</button>
				))
			}
		</div>

		<div class="mt-12 lg:mt-16">
			{
				projects.map((project, i) => (
					<>
						<article
							class="group grid gap-6 rounded-panel border-t border-ink/15 py-8 transition-colors duration-500 ease-glass hover:bg-white/45 lg:grid-cols-12 lg:gap-6"
							data-project-row
							data-tags={project.tags.join('|')}
						>
							<div class="lg:col-span-1">
								<span
									class:list={[
										'text-5xl font-black leading-none transition-colors duration-500 ease-glass group-hover:text-accent',
										i === 0 ? 'text-accent' : 'text-ink/30',
									]}
								>
									{project.index}
								</span>
							</div>
						<div class="lg:col-span-3">
							<h3 class="text-4xl font-black uppercase leading-none transition-transform duration-500 ease-spring group-hover:translate-x-2 lg:text-5xl">
								{project.title}
							</h3>
							<p class="t-label mt-4 text-ink-soft">{project.type}</p>
							<p class="mt-2 font-mono text-xs text-ink-faint">{project.year}</p>
						</div>
						<div class="lg:col-span-3">
							<div class="overflow-hidden rounded-panel border border-ink/10">
								<img
									src={thumbs[project.index]}
									alt=""
									aria-hidden="true"
									loading="lazy"
									width="800"
									height="600"
									class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-spring group-hover:scale-[1.04]"
								/>
							</div>
						</div>
						<div class="lg:col-span-3">
								<p class="text-base leading-relaxed text-ink-soft">{project.summary}</p>
								<div class="mt-5 flex flex-wrap items-center gap-2">
									{project.tags.map((tag) => (
										<span class="rounded-panel border border-ink/20 px-2 py-1 font-mono text-xs uppercase tracking-wide text-ink-soft">
											{tag}
										</span>
									))}
									{project.url ? (
										<a
											href={project.url}
											target="_blank"
											rel="noopener noreferrer"
											class="ml-2 font-mono text-xs uppercase tracking-wide text-accent hover:underline focus-visible:ring-2 focus-visible:ring-accent"
										>
											Live site ↗
										</a>
									) : (
										<span class="ml-2 font-mono text-xs uppercase tracking-wide text-ink-faint">
											{project.status}
										</span>
									)}
								</div>
							</div>
							<div class="flex items-start lg:col-span-2 lg:justify-end">
								<button
									type="button"
									data-case-toggle
									aria-expanded="false"
									aria-controls={`case-${project.index}`}
									class="glass-light glass-edge rounded-panel px-4 py-3 text-left transition-colors duration-300 ease-glass hover:text-accent focus-visible:ring-2 focus-visible:ring-accent"
								>
									<span class="t-label block text-ink-faint">Case study</span>
									<span class="mt-1 block font-mono text-xs uppercase tracking-widest text-ink" data-case-label>
										+ Open
									</span>
								</button>
							</div>
						</article>
						<div class="overflow-hidden" id={`case-${project.index}`} data-case-panel hidden>
							<div class="glass-light glass-edge rounded-glass mt-4 overflow-x-auto p-6 sm:p-8">
								<div class="grid gap-8 lg:grid-cols-12 lg:gap-6">
									<div class="lg:col-span-4">
										<p class="t-label text-accent">Challenge</p>
										<p class="mt-3 text-base leading-relaxed text-ink-soft">
											{project.caseStudy.challenge}
										</p>
									</div>
									<div class="lg:col-span-5">
										<p class="t-label text-ink-faint">Approach</p>
										<ol class="mt-4 space-y-4">
											{project.caseStudy.approach.map((step, si) => (
												<li class="border-l-2 border-ink/15 pl-4">
													<span class="font-mono text-xs text-accent">
														{String(si + 1).padStart(2, '0')}
													</span>
													<p class="mt-1 text-sm leading-relaxed text-ink-soft">{step}</p>
												</li>
											))}
										</ol>
									</div>
									<div class="lg:col-span-3">
										<p class="t-label text-ink-faint">Outcome</p>
										<p class="mt-3 text-sm leading-relaxed text-ink-soft">
											{project.caseStudy.outcome}
										</p>
										<div class="mt-6 space-y-4">
											{project.caseStudy.metrics.map((metric) => (
												<div>
													<p class="text-2xl font-black leading-none text-ink">{metric.value}</p>
													<p class="t-label mt-1 text-ink-faint">{metric.label}</p>
												</div>
											))}
										</div>
										{project.url && (
											<a
												href={project.url}
												target="_blank"
												rel="noopener noreferrer"
												class="mt-6 inline-block rounded-panel bg-ink px-4 py-2 font-mono text-xs uppercase tracking-widest text-paper transition-colors duration-300 ease-glass hover:bg-accent focus-visible:ring-2 focus-visible:ring-accent"
											>
												Visit ↗
											</a>
										)}
									</div>
								</div>
							</div>
						</div>
					</>
				))
			}
		</div>
	</div>
</section>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const rows = gsap.utils.toArray<HTMLElement>('[data-project-row]');
	const filterButtons = gsap.utils.toArray<HTMLButtonElement>('[data-filter]');

	function setButtonState(panelId: string, expanded: boolean) {
		const button = document.querySelector<HTMLButtonElement>(`[aria-controls="${panelId}"]`);
		if (!button) return;
		button.setAttribute('aria-expanded', String(expanded));
		const label = button.querySelector('[data-case-label]');
		if (label) label.textContent = expanded ? '− Close' : '+ Open';
	}

	function closePanel(panel: HTMLElement) {
		if (reduceMotion) {
			gsap.set(panel, { clearProps: 'height,opacity' });
			panel.setAttribute('hidden', '');
			setButtonState(panel.id, false);
			return;
		}
		gsap.to(panel, {
			height: 0,
			opacity: 0,
			duration: 0.45,
			ease: 'power4.inOut',
			onComplete: () => {
				panel.setAttribute('hidden', '');
				gsap.set(panel, { clearProps: 'height,opacity' });
				setButtonState(panel.id, false);
			},
		});
	}

	function openPanel(panel: HTMLElement) {
		panel.removeAttribute('hidden');
		setButtonState(panel.id, true);
		if (reduceMotion) return;
		const target = panel.scrollHeight;
		gsap.fromTo(
			panel,
			{ height: 0, opacity: 0 },
			{
				height: target,
				opacity: 1,
				duration: 0.6,
				ease: 'expo.out',
				onComplete: () => gsap.set(panel, { height: 'auto' }),
			}
		);
	}

	function panelOfRow(row: HTMLElement) {
		const button = row.querySelector<HTMLButtonElement>('[data-case-toggle]');
		const panelId = button?.getAttribute('aria-controls');
		return panelId ? document.getElementById(panelId) : null;
	}

	document.querySelectorAll<HTMLButtonElement>('[data-case-toggle]').forEach((button) => {
		button.addEventListener('click', () => {
			const panelId = button.getAttribute('aria-controls');
			if (!panelId) return;
			const panel = document.getElementById(panelId);
			if (!panel) return;
			const isOpen = button.getAttribute('aria-expanded') === 'true';
			const current = document.querySelector<HTMLElement>('[data-case-panel]:not([hidden])');
			if (current && current !== panel) closePanel(current);
			if (isOpen) closePanel(panel);
			else openPanel(panel);
		});
	});

	function applyFilter(tag: string) {
		const matched: HTMLElement[] = [];
		const rest: HTMLElement[] = [];
		rows.forEach((row) => {
			const tags = (row.getAttribute('data-tags') ?? '').split('|');
			if (tag === 'All' || tags.includes(tag)) matched.push(row);
			else rest.push(row);
		});
		rest.forEach((row) => {
			const panel = panelOfRow(row);
			if (panel && !panel.hasAttribute('hidden')) closePanel(panel);
		});
		if (reduceMotion) {
			matched.forEach((row) => {
				row.style.display = '';
				gsap.set(row, { clearProps: 'opacity,transform' });
			});
			rest.forEach((row) => {
				row.style.display = 'none';
			});
			return;
		}
		gsap.killTweensOf(rows);
		const timeline = gsap.timeline();
		if (rest.length) {
			timeline.to(rest, {
				opacity: 0,
				scale: 0.97,
				y: 12,
				duration: 0.3,
				ease: 'power2.in',
				onComplete: () => gsap.set(rest, { display: 'none' }),
			});
		}
		gsap.set(matched, { clearProps: 'display' });
		timeline.fromTo(
			matched,
			{ opacity: 0, scale: 0.97, y: 18 },
			{
				opacity: 1,
				scale: 1,
				y: 0,
				duration: 0.6,
				ease: 'power4.out',
				stagger: 0.05,
				clearProps: 'scale,y',
			},
			rest.length ? '-=0.1' : undefined
		);
	}

	filterButtons.forEach((button) => {
		button.addEventListener('click', () => {
			filterButtons.forEach((other) => {
				const active = other === button;
				other.setAttribute('aria-pressed', String(active));
				other.classList.toggle('bg-ink', active);
				other.classList.toggle('text-paper', active);
				other.classList.toggle('glass-light', !active);
				other.classList.toggle('text-ink-soft', !active);
				other.classList.toggle('hover:text-ink', !active);
			});
			applyFilter(button.getAttribute('data-filter') ?? 'All');
		});
	});

	if (reduceMotion) {
		gsap.set(rows, { clearProps: 'all', opacity: 1 });
	} else {
		gsap.set(rows, { y: 50, opacity: 0 });
		ScrollTrigger.batch(rows, {
			start: 'top 88%',
			once: true,
			onEnter: (batch) => {
				gsap.to(batch, {
					y: 0,
					opacity: 1,
					duration: 0.9,
					ease: 'power4.out',
					stagger: 0.06,
					overwrite: true,
				});
			},
		});
	}
</script>
