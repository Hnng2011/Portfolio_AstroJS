const match = icons.find(([keys]) => keys.some((k) => key.includes(k)));
---

{
	match && (
		<svg
			class="doodle-icon"
			viewBox="0 0 24 24"
			width="20"
			height="20"
			fill="none"
			stroke="currentColor"
			stroke-width="1.7"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
			set:html={match[1]}
		/>
	)
}

<style>
	.doodle-icon {
		flex: none;
		width: 1.25em;
		height: 1.25em;
		filter: url(#doodle-ink);
		transform: rotate(-4deg);
	}
</style>
