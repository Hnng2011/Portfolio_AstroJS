---
import FrontHead from './FrontHead.astro';

const SKIN = '#f7d2b0';
const TEE = '#2e2823';
const PANTS = '#27221e';
const PACK = '#5fb3a3';
const PACK_DARK = '#4b9a8b';
---

<svg
	class="me-art me-wave"
	viewBox="0 0 400 520"
	fill="none"
	stroke="#17130f"
	stroke-width="3"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	<rect x="92" y="206" width="216" height="200" rx="50" fill={PACK} />
	<rect x="96" y="318" width="22" height="44" rx="8" fill={PACK_DARK} stroke-width="2.4" />
	<rect x="282" y="318" width="22" height="44" rx="8" fill={PACK_DARK} stroke-width="2.4" />

	<path d="M164 412h30l2 66h-34z" fill={PANTS} />
	<ellipse cx="176" cy="486" rx="27" ry="13" fill="#fbf7ef" />
	<path d="M168 480l8-3" stroke-width="2.2" />
	<path d="M206 412h30l2 66h-34z" fill={PANTS} />
	<ellipse cx="226" cy="486" rx="27" ry="13" fill="#fbf7ef" />
	<path d="M220 480l8-3" stroke-width="2.2" />

	<g class="wave-arm">
		<path d="M284 252q34-12 46-58" stroke-width="22" />
		<path d="M284 252q34-12 46-58" stroke={SKIN} stroke-width="16" />
		<path d="M314 186q2-14 4-22M326 182q0-16 2-26M338 184q2-14 6-22M346 194q6-6 12-8" stroke-width="7" />
		<path d="M314 186q2-14 4-22M326 182q0-16 2-26M338 184q2-14 6-22M346 194q6-6 12-8" stroke={SKIN} stroke-width="3" />
		<ellipse cx="330" cy="194" rx="18" ry="16" fill={SKIN} />
	</g>

	<path d="M184 196h32v44h-32z" fill={SKIN} />
	<path d="M138 236q62-22 124 0l26-10 16 28-30 14-8-4-2 152H140l-2-112-18-6z" fill={TEE} />
	<path d="M176 230q24 12 48 0" stroke-width="2.6" />
	<path d="M156 228q6 40 4 90M244 228q-6 40-4 90" stroke-width="16" />
	<path d="M156 228q6 40 4 90M244 228q-6 40-4 90" stroke={PACK} stroke-width="10" />

	<path d="M128 302q-14 52-10 106" stroke-width="22" />
	<path d="M128 302q-14 52-10 106" stroke={SKIN} stroke-width="16" />
	<ellipse cx="118" cy="414" rx="14" ry="13" fill={SKIN} />


	<FrontHead />
</svg>

<style>
	.me-wave :global(.wave-arm) {
		transform-box: view-box;
		transform-origin: 286px 250px;
		animation: wave 0.55s ease-in-out infinite alternate;
	}

	.me-wave :global(.me-mouth) {
		scale: 1.15 1.3;
		transform-box: fill-box;
		transform-origin: 50% 0;
	}

	@keyframes wave {
		from {
			rotate: -14deg;
		}
		to {
			rotate: 12deg;
		}
	}
</style>
