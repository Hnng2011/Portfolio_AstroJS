---
import FrontHead from './FrontHead.astro';

interface Props {
	layer: 'back' | 'front';
}

const { layer } = Astro.props;
const INK = '#17130f';
const SKIN = '#f7d2b0';
const HAIR = '#1f1a16';
const TEE = '#2e2823';
const PANTS = '#27221e';
const PACK = '#5fb3a3';
const PACK_DARK = '#4b9a8b';
const GLASS = 'rgb(122 166 217 / 0.28)';
const INSIDE = '#e8e6e0';
---

<svg
	class:list={['me-art', `me-${layer}`]}
	viewBox="0 0 400 520"
	fill="none"
	stroke={INK}
	stroke-width="3"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		layer === 'back' ? (
			<g>
				<g class="pose pose-front">
					<rect x="92" y="206" width="216" height="200" rx="50" fill={PACK} />
					<path d="M100 300h22M278 300h22" stroke-width="2.4" />
					<rect x="96" y="318" width="22" height="44" rx="8" fill={PACK_DARK} stroke-width="2.4" />
					<rect x="282" y="318" width="22" height="44" rx="8" fill={PACK_DARK} stroke-width="2.4" />

					<g class="me-leg me-leg-l">
						<path d="M164 418h30l2 60h-34z" fill={PANTS} />
						<ellipse cx="176" cy="486" rx="27" ry="13" fill="#fbf7ef" />
						<path d="M168 480l8-3" stroke-width="2.2" />
					</g>
					<g class="me-leg me-leg-r">
						<path d="M206 418h30l2 60h-34z" fill={PANTS} />
						<ellipse cx="226" cy="486" rx="27" ry="13" fill="#fbf7ef" />
						<path d="M220 480l8-3" stroke-width="2.2" />
					</g>

					<path d="M184 196h32v44h-32z" fill={SKIN} />
					<path d="M138 236q62-22 124 0l18 66-18 6-2 112H140l-2-112-18-6z" fill={TEE} />
					<path d="M176 230q24 12 48 0" stroke-width="2.6" />
					<path d="M156 228q6 40 4 90M244 228q-6 40-4 90" stroke-width="16" />
					<path d="M156 228q6 40 4 90M244 228q-6 40-4 90" stroke={PACK} stroke-width="10" />

					<path d="M128 302q-18 44-20 92" stroke-width="22" />
					<path d="M128 302q-18 44-20 92" stroke={SKIN} stroke-width="16" />
					<path d="M272 302q30 32 36 80" stroke-width="22" />
					<path d="M272 302q30 32 36 80" stroke={SKIN} stroke-width="16" />

					<FrontHead />

					<path d="M110 258l24-18h180v180l-24 18H110z" fill={INSIDE} stroke="none" />
					<path d="M110 258l24-18h180l-24 18zM290 258l24-18v180l-24 18z" fill={GLASS} stroke="none" />
					<path d="M134 240v180h180M110 438l24-18" stroke-width="2" opacity="0.3" stroke-dasharray="6 6" />
				</g>

				<g class="pose pose-side">
					<g class="pose-mirror">
						<g class="side-leg side-leg-back">
							<path d="M72 396h24l2 70H70z" fill="#1d1916" />
							<path d="M66 470q4-14 24-12 18 2 26 14 2 8-6 10H70q-6-4-4-12z" fill="#ece6da" />
						</g>

						<rect x="14" y="230" width="52" height="156" rx="22" fill={PACK} />
						<rect x="20" y="316" width="38" height="46" rx="10" fill={PACK_DARK} stroke-width="2.4" />
						<path d="M26 300h28" stroke-width="2.4" />

						<path d="M92 206h22v40H92z" fill={SKIN} />
						<path d="M52 246q38-20 80-4l4 166H56z" fill={TEE} />
						<path d="M60 248q26-16 52 0" stroke-width="15" />
						<path d="M60 248q26-16 52 0" stroke={PACK} stroke-width="9" />

						<g class="side-leg side-leg-front">
							<path d="M84 396h24l2 70H82z" fill={PANTS} />
							<path d="M78 470q4-14 24-12 18 2 26 14 2 8-6 10H82q-6-4-4-12z" fill="#fbf7ef" />
							<path d="M96 466l10-3" stroke-width="2.2" />
						</g>

						<g transform="translate(2 18)">
						<g class="me-head">
								<ellipse cx="128" cy="146" rx="60" ry="62" fill={SKIN} />
								<path
									d="M52 188C22 150 20 70 80 46c50-22 106-6 116 38q4 18-2 30l-12-10-6 16-12-14-8 16-12-14-8 14-12-12q-22 2-26 30-2 36-22 58-14 2-24-10z"
									fill={HAIR}
								/>
								<path d="M66 82q18-22 44-26M60 104q6-12 14-18" stroke="#5a524a" stroke-width="3.4" />
								<circle cx="98" cy="156" r="14" fill={SKIN} />
								<path d="M94 150q7 4 4 12" stroke-width="2.2" />
								<path d="M186 140q10 8 1 16" fill={SKIN} stroke-width="2.6" />
								<path d="M148 130q10-6 20-1" stroke-width="2.6" />
								<g class="me-eyes">
									<ellipse cx="160" cy="152" rx="7" ry="9.5" fill={INK} stroke="none" />
									<circle cx="162.4" cy="147.6" r="2.6" fill="#fff" stroke="none" />
								</g>
								<ellipse cx="140" cy="174" rx="11" ry="6.5" fill="#f1958a" stroke="none" opacity="0.6" />
								<path d="M157 180q8 9 16 0z" fill="#b9584a" stroke-width="2.4" />
							</g>
						</g>
					</g>
					<rect x="110" y="258" width="180" height="180" fill={INSIDE} stroke="none" />
				</g>

				<rect data-cube-face x="110" y="258" width="180" height="180" fill="none" stroke="none" />
			</g>
		) : (
			<g>
				<rect x="110" y="258" width="180" height="180" rx="5" fill="rgb(122 166 217 / 0.07)" stroke-width="3.4" />
				<g class="pose pose-front">
					<path d="M110 258l24-18h180l-24 18M290 258l24-18v180l-24 18" stroke-width="3.2" />
					<path d="M150 251h60" stroke="#fff" stroke-width="4" opacity="0.7" />
					<path d="M300 262v40" stroke="#fff" stroke-width="4" opacity="0.6" />
				</g>
				<g class="cube-glare">
					<path d="M126 306l34-34M126 330l16-16" stroke="#fff" stroke-width="6" opacity="0.75" />
				</g>

				<g class="pose pose-side">
					<g class="pose-mirror">
						<path d="M78 252q32-12 50 12l-6 46q-26 6-44-6z" fill={TEE} />
						<path d="M104 300q2 74 40 120 18 18 40 18" stroke-width="22" />
						<path d="M104 300q2 74 40 120 18 18 40 18" stroke={SKIN} stroke-width="16" />
						<ellipse cx="190" cy="440" rx="18" ry="12" fill={SKIN} />
						<path d="M180 432q8-6 16-4M186 436q8-5 15-2" stroke-width="2.2" />
						<path d="M288 270l7-1 1 36-7 1z" fill="#fbf7ef" stroke-width="2.2" />
						<path d="M284 272l14-2" stroke="#f2a541" stroke-width="5" opacity="0.85" />
						<ellipse cx="286" cy="300" rx="11" ry="14" fill={SKIN} />
						<path d="M280 294q6 2 8 8" stroke-width="2.2" />
					</g>
				</g>

				<g class="cube-label cube-label-r" transform="rotate(5 232 288)">
					<rect x="172" y="270" width="114" height="36" rx="4" fill="#fbf7ef" stroke-width="2.6" />
					<text
						x="229"
						y="295"
						text-anchor="middle"
						fill={INK}
						stroke="none"
						font-family="Shantell Sans, Comic Sans MS, sans-serif"
						font-size="20"
						font-weight="800"
					>
						my work
					</text>
					<rect x="214" y="261" width="34" height="15" fill="#f2a541" opacity="0.8" stroke="none" transform="rotate(-4 231 268)" />
					<rect x="264" y="296" width="24" height="12" fill="#f2a541" opacity="0.8" stroke="none" transform="rotate(38 276 302)" />
				</g>

				{[
					[78, 262, 0],
					[332, 214, 1],
					[346, 330, 2],
					[64, 360, 3],
					[96, 470, 4],
					[318, 470, 5],
				].map(([x, y, i]) => (
					<g transform={`translate(${x} ${y})`}>
						<path
							class="me-spark"
							style={`--i: ${i}`}
							d="M0-12q2.4-2.4 0 0 2.4 9.6 12 12-9.6 2.4-12 12-2.4-9.6-12-12 9.6-2.4 12-12z"
							fill="#f2a541"
							stroke-width="2.2"
						/>
					</g>
				))}

				<g class="pose pose-front">
					<ellipse cx="108" cy="400" rx="15" ry="13" fill={SKIN} />
					<path d="M112 392q10 1 13 7M112 401q10 1 13 7" stroke-width="2.4" />
					<ellipse cx="310" cy="388" rx="14" ry="13" fill={SKIN} />
					<path d="M304 380q-9 1-12 7M304 389q-9 1-12 7" stroke-width="2.4" />
				</g>
			</g>
		)
	}
</svg>
