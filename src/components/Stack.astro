---
import { skills } from '../data/portfolio';

const cards = [
	{ kind: 'intro', label: '03 — Stack', body: skills.statement },
	...skills.primary.map((s) => ({ kind: 'xl', label: 'Core', body: s })),
	...skills.secondary.map((s) => ({ kind: 'md', label: 'Secondary', body: s })),
	...skills.tertiary.map((s) => ({ kind: 'sm', label: 'Tooling', body: s })),
];
---

<section id="stack" class="relative">
	<div data-stack-pin class="overflow-hidden bg-coal">
		<div class="flex min-h-svh items-center py-24">
			<div
				data-track
				class="grid grid-cols-1 gap-4 px-5 py-16 md:flex md:items-stretch md:gap-8 md:px-8 md:py-24"
			>
				{
					cards.map((c, i) => (
						<div
							class:list={[
								'skill-card group relative flex shrink-0 flex-col justify-between border border-bone/12 p-6 transition-colors duration-500 hover:border-flame/60 md:p-8',
								c.kind === 'intro' && 'w-full bg-flame md:w-[36rem]',
								c.kind === 'xl' && 'w-full bg-smoke md:w-[30rem]',
								c.kind === 'md' && 'w-full bg-coal md:w-[22rem]',
								c.kind === 'sm' && 'w-full bg-void md:w-[17rem]',
							]}
							data-card
						>
							<div class="flex items-center justify-between">
								<span class:list={['t-mono', c.kind === 'intro' ? 'text-void/70' : 'text-dim']}>
									{c.label}
								</span>
								<span class:list={['t-mono', c.kind === 'intro' ? 'text-void/70' : 'text-dim']}>
									{String(i + 1).padStart(2, '0')}
								</span>
							</div>
							<p
								class:list={[
									'font-display tracking-tight uppercase',
									c.kind === 'intro' ? 't-sub text-void' : 'text-bone',
									c.kind === 'xl' && 'text-5xl md:text-7xl',
									c.kind === 'md' && 'text-3xl md:text-5xl',
									c.kind === 'sm' && 'text-2xl md:text-3xl',
								]}
							>
								{c.body}
							</p>
							<div class="h-px w-full bg-current opacity-15 transition-all duration-700 group-hover:opacity-60"></div>
						</div>
					))
				}
				<div class="flex w-full shrink-0 items-center md:w-[16rem]">
					<p class="t-mono text-dim">End of stack → back to work</p>
				</div>
			</div>
		</div>
	</div>
	<div class="h-px w-full bg-bone/10" aria-hidden="true">
		<div class="h-px bg-flame" data-stack-progress style="width:0%"></div>
	</div>
</section>

<style>
	.skill-card {
		min-height: 16rem;
	}
</style>

<script>
	import { gsap, ScrollTrigger, reduced } from '../lib/motion';

	const pin = document.querySelector('[data-stack-pin]')!;
	const track = document.querySelector('[data-track]') as HTMLElement;
	const progress = document.querySelector('[data-stack-progress]') as HTMLElement;

	const mm = gsap.matchMedia();
	mm.add('(min-width: 768px) and (prefers-reduced-motion: no-preference)', () => {
		const distance = () => track.scrollWidth - window.innerWidth;
		const tween = gsap.to(track, {
			x: () => -distance(),
			ease: 'none',
			scrollTrigger: {
				trigger: pin,
				start: 'top top',
				end: () => `+=${distance()}`,
				pin: true,
				scrub: 0.7,
				invalidateOnRefresh: true,
				onToggle: (self) => document.body.classList.toggle('rail-off', self.isActive),
				onUpdate: (self) => {
					progress.style.width = `${self.progress * 100}%`;
				},
			},
		});
		gsap.utils.toArray('[data-card]').forEach((card, i) => {
			gsap.fromTo(
				card,
				{ y: i % 2 ? 40 : -40, opacity: 0.4 },
				{
					y: 0,
					opacity: 1,
					ease: 'none',
					scrollTrigger: { trigger: pin, start: 'top top', end: () => `+=${distance() * 0.4}`, scrub: 0.7 },
				},
			);
		});
		return () => tween.scrollTrigger?.kill();
	});
</script>
