	.note-outcome p {
		line-height: 1.45rem;
		background: repeating-linear-gradient(
			transparent 0 calc(1.45rem - 1.5px),
			rgb(122 166 217 / 0.5) calc(1.45rem - 1.5px) 1.45rem
		);
	}

	/* A big piece of paper and its inked edge sit on layers under its text, so the text stays crisp. It is
	   too big to re-filter eight times a second, so it is three copies, each filtered once with a still
	   frame of the character's boil, and only which copy shows changes (an opacity step on the
	   compositor, as in the meadow). */
	.boil {
		position: absolute;
		inset: calc(var(--line) * -1);
		z-index: -1;
		border-radius: inherit;
		pointer-events: none;
		will-change: opacity;
		animation: card-boil 0.375s steps(1) calc(var(--f) * -0.125s) infinite;
	}

	.boil + .boil {
		opacity: 0;
	}

	.boil::before {
		content: '';
		position: absolute;
		inset: 0;
		border: var(--line) solid var(--color-ink);
		border-radius: inherit;
		background: var(--paper);
		filter: var(--frame);
	}

	/* A hair over a third, so a step never falls between two copies and shows no paper. */
	@keyframes card-boil {
