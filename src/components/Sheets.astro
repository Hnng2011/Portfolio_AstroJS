<script>
	document.querySelectorAll<HTMLElement>('.case-media').forEach((media) => {
		const tabs = [...media.querySelectorAll<HTMLButtonElement>('[data-tab]')];
		const views = [...media.querySelectorAll<HTMLElement>('.shot-view')];
		tabs.forEach((tab) =>
			tab.addEventListener('click', () => {
				for (const t of tabs) t.setAttribute('aria-pressed', String(t === tab));
				for (const v of views) v.hidden = v.dataset.view !== tab.dataset.tab;
				media.dataset.view = tab.dataset.tab;
			}),
		);
	});
</script>
