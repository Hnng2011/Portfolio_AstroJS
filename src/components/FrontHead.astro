---
const INK = '#17130f';
const SKIN = '#f7d2b0';
const HAIR = '#1f1a16';
---

<g class="me-head">
	<path d="M130 130q0 74 70 86 70-12 70-86 0-58-70-62-70 4-70 62z" fill={SKIN} />
	<path
		d="M118 152C102 96 126 36 200 32c74 4 98 64 82 120l-6 10q-4-30-12-52l-8 18-10-22-12 20-12-24-10 24-12-24-12 24-12-22-12 24-12-20-8 14q-12 14-14 38z"
		fill={HAIR}
	/>
	<path d="M148 60q26-16 58-16M124 100q4-14 12-22" stroke="#5a524a" stroke-width="3.4" />
	<circle cx="124" cy="152" r="15" fill={SKIN} />
	<circle cx="276" cy="152" r="15" fill={SKIN} />
	<path d="M122 146q6 4 4 12M278 146q-6 4-4 12" stroke-width="2.2" />
	<path d="M158 135q10-5 20-1M222 134q10-4 20 1" stroke-width="2.6" />
	<g class="me-happy">
		<path d="M163 155q9-12 18 0M219 155q9-12 18 0" stroke-width="3.4" />
	</g>
	<g class="me-eyes">
		<ellipse cx="172" cy="152" rx="7.5" ry="9.5" fill={INK} stroke="none" />
		<ellipse cx="228" cy="152" rx="7.5" ry="9.5" fill={INK} stroke="none" />
		<circle cx="174.6" cy="147.6" r="2.8" fill="#fff" stroke="none" />
		<circle cx="230.6" cy="147.6" r="2.8" fill="#fff" stroke="none" />
	</g>
	<ellipse cx="154" cy="175" rx="11" ry="6.5" fill="#f1958a" stroke="none" opacity="0.6" />
	<ellipse cx="246" cy="175" rx="11" ry="6.5" fill="#f1958a" stroke="none" opacity="0.6" />
	<path d="M199 164q3 3 0 6" stroke-width="2.2" />
	<path class="me-mouth" d="M188 180q12 14 24 0z" fill="#b9584a" stroke-width="2.6" />
</g>

<style>
	.me-head {
		transform-box: fill-box;
		transform-origin: 50% 100%;
		animation: head-bob 3.2s ease-in-out infinite alternate;
	}

	.me-happy {
		opacity: 0;
	}

	.me-eyes {
		transform-box: fill-box;
		transform-origin: center;
		animation: head-blink 4.6s linear infinite;
	}

	@keyframes head-bob {
		from {
			transform: translateY(0) rotate(-1.2deg);
		}
		to {
			transform: translateY(-4px) rotate(1.2deg);
		}
	}

	@keyframes head-blink {
		0%,
		94%,
		100% {
			transform: scaleY(1);
		}
		96% {
			transform: scaleY(0.1);
		}
	}
</style>
