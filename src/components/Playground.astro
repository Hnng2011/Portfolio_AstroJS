---
---

<section id="lab" class="tone-dark overflow-hidden py-24 lg:py-32">
	<div class="swiss-container">
		<div class="grid gap-10 lg:grid-cols-12 lg:gap-6">
			<div class="lg:col-span-5">
				<p class="font-mono text-sm text-accent" data-lab-reveal>03 —</p>
				<p class="t-label mt-4 text-frost-dim" data-lab-reveal>Interactive playground</p>
				<h2 class="t-headline mt-5" data-lab-reveal>
					Glass<br /><span class="stroke-title">Lab.</span>
				</h2>
			</div>
			<div class="self-end lg:col-span-6 lg:col-start-7" data-lab-reveal>
				<p class="max-w-prose text-base leading-relaxed text-frost-dim lg:text-lg">
					A small laboratory for frosted glass. Drag the panels across the stage, tune blur,
					opacity and tint through the token sliders, then release — every interaction settles
					back with real spring physics.
				</p>
				<p class="mt-5 flex items-center gap-2 font-mono text-xs text-frost-dim">
					<span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
					drag the panels / tune the tokens
				</p>
			</div>
		</div>

		<div class="mt-14 grid gap-6 lg:mt-20 lg:grid-cols-12 lg:gap-6">
			<div class="lg:col-span-8" data-lab-reveal>
				<div
					class="lab-stage relative aspect-[3/4] overflow-hidden rounded-glass sm:aspect-[4/3] lg:aspect-[4/3]"
					data-lab-stage
				>
					<div
						class="slab-item absolute left-[5%] top-[9%] z-10 h-44 w-28 sm:h-52 sm:w-40"
						data-slab-item
						data-depth="1"
					>
						<div class="lab-slab glass-edge rounded-glass">
							<span class="slab-num" aria-hidden="true">01</span>
							<div class="absolute inset-x-4 bottom-4">
								<p class="t-label text-frost">Layer 01</p>
								<p class="mt-1.5 font-mono text-[10px] tracking-wider text-frost-dim" data-slab-meta>
									BLUR 24 / OP 8%
								</p>
							</div>
						</div>
					</div>
					<div
						class="slab-item absolute left-[23%] top-[30%] z-20 h-48 w-32 sm:h-56 sm:w-44"
						data-slab-item
						data-depth="2"
					>
						<div class="lab-slab glass-edge rounded-glass">
							<span class="slab-num" aria-hidden="true">02</span>
							<div class="absolute inset-x-4 bottom-4">
								<p class="t-label text-frost">Layer 02</p>
								<p class="mt-1.5 font-mono text-[10px] tracking-wider text-frost-dim" data-slab-meta>
									BLUR 24 / OP 8%
								</p>
							</div>
						</div>
					</div>
					<div
						class="slab-item absolute left-[43%] top-[7%] z-30 h-46 w-30 sm:h-60 sm:w-48"
						data-slab-item
						data-depth="3"
					>
						<div class="lab-slab glass-edge rounded-glass">
							<span class="slab-num" aria-hidden="true">03</span>
							<div class="absolute inset-x-4 bottom-4">
								<p class="t-label text-frost">Layer 03</p>
								<p class="mt-1.5 font-mono text-[10px] tracking-wider text-frost-dim" data-slab-meta>
									BLUR 24 / OP 8%
								</p>
							</div>
						</div>
					</div>
					<div
						class="slab-item absolute left-[57%] top-[33%] z-40 h-52 w-36 sm:h-64 sm:w-52"
						data-slab-item
						data-depth="4"
					>
						<div class="lab-slab glass-edge rounded-glass">
							<span class="slab-num" aria-hidden="true">04</span>
							<div class="absolute inset-x-4 bottom-4">
								<p class="t-label text-frost">Layer 04</p>
								<p class="mt-1.5 font-mono text-[10px] tracking-wider text-frost-dim" data-slab-meta>
									BLUR 24 / OP 8%
								</p>
							</div>
						</div>
					</div>
					<div
						class="slab-item absolute left-[33%] top-[50%] z-50 h-56 w-40 sm:h-72 sm:w-56"
						data-slab-item
						data-depth="5"
					>
						<div class="lab-slab glass-edge rounded-glass">
							<span class="slab-num" aria-hidden="true">05</span>
							<div class="absolute inset-x-4 bottom-4">
								<p class="t-label text-frost">Layer 05</p>
								<p class="mt-1.5 font-mono text-[10px] tracking-wider text-frost-dim" data-slab-meta>
									BLUR 24 / OP 8%
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="lg:col-span-4" data-lab-reveal>
				<div class="glass-dark glass-edge rounded-glass p-6">
					<p class="t-label text-frost-dim">Token controls</p>
					<div class="mt-7 space-y-7">
						<div>
							<div class="flex items-baseline justify-between gap-4">
								<label for="lab-blur" class="t-label text-frost">Blur</label>
								<output for="lab-blur" class="font-mono text-xs text-accent-soft" data-lab-blur-out
									>24px</output
								>
							</div>
							<input
								id="lab-blur"
								type="range"
								min="0"
								max="40"
								step="1"
								value="24"
								class="lab-range mt-3"
								data-lab-blur
							/>
						</div>
						<div>
							<div class="flex items-baseline justify-between gap-4">
								<label for="lab-alpha" class="t-label text-frost">Opacity</label>
								<output for="lab-alpha" class="font-mono text-xs text-accent-soft" data-lab-alpha-out
									>8%</output
								>
							</div>
							<input
								id="lab-alpha"
								type="range"
								min="3"
								max="30"
								step="1"
								value="8"
								class="lab-range mt-3"
								data-lab-alpha
							/>
						</div>
						<div>
							<div class="flex items-baseline justify-between gap-4">
								<label for="lab-tint" class="t-label text-frost">Tint</label>
								<output for="lab-tint" class="font-mono text-xs text-accent-soft" data-lab-tint-out
									>0°</output
								>
							</div>
							<input
								id="lab-tint"
								type="range"
								min="0"
								max="180"
								step="1"
								value="0"
								class="lab-range mt-3"
								data-lab-tint
							/>
						</div>
					</div>
					<div class="mt-9 flex flex-wrap gap-3">
						<button
							type="button"
							class="t-label rounded-panel border border-white/20 px-5 py-3 text-frost transition-colors duration-300 hover:border-white/45 focus-visible:ring-2 focus-visible:ring-accent"
							data-lab-reset
						>
							Reset
						</button>
						<button
							type="button"
							class="t-label rounded-panel bg-accent px-5 py-3 text-white transition-transform duration-300 hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-accent"
							data-lab-scatter
						>
							Scatter
						</button>
					</div>
					<p class="mt-7 font-mono text-[10px] tracking-wider text-frost-dim">
						gsap draggable + inertia / elastic spring release
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.lab-stage {
		--lab-blur: 24px;
		--lab-alpha: 0.08;
		--lab-tint: 0deg;
		border: 1px solid rgb(255 255 255 / 0.1);
		background-color: rgb(10 12 18 / 0.35);
		background-image: radial-gradient(rgb(255 255 255 / 0.085) 1px, transparent 1.4px);
		background-size: 24px 24px;
	}

	.lab-slab {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		cursor: grab;
		background: rgb(255 255 255 / var(--lab-alpha));
		backdrop-filter: blur(var(--lab-blur)) saturate(160%) hue-rotate(var(--lab-tint));
		-webkit-backdrop-filter: blur(var(--lab-blur)) saturate(160%) hue-rotate(var(--lab-tint));
		border: 1px solid rgb(255 255 255 / 0.14);
		box-shadow: var(--shadow-glass-dark);
		transition:
			box-shadow 0.4s var(--ease-glass),
			border-color 0.4s var(--ease-glass);
		will-change: transform;
	}

	.lab-slab.is-pressed {
		cursor: grabbing;
		box-shadow: var(--shadow-lift);
	}

	.lab-slab.border-accent\/60 {
		border-color: rgb(232 56 13 / 0.6);
	}

	.slab-num {
		position: absolute;
		top: 0.35rem;
		left: 0.9rem;
		font-size: clamp(2.6rem, 5vw, 4.2rem);
		font-weight: 900;
		line-height: 1;
		letter-spacing: -0.02em;
		color: rgb(255 255 255 / 0.12);
		user-select: none;
		pointer-events: none;
	}

	.lab-range {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 2px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.18);
		accent-color: var(--color-accent);
		cursor: pointer;
	}

	.lab-range:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 6px;
	}

	.lab-range::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 18px;
		height: 18px;
		border-radius: 999px;
		background: var(--color-frost);
		border: 2px solid var(--color-accent);
		box-shadow: 0 4px 14px rgb(0 0 0 / 0.45);
	}

	.lab-range::-moz-range-thumb {
		width: 18px;
		height: 18px;
		border-radius: 999px;
		background: var(--color-frost);
		border: 2px solid var(--color-accent);
		box-shadow: 0 4px 14px rgb(0 0 0 / 0.45);
	}

	.lab-stage.is-static {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
		align-content: center;
		gap: 1rem;
		padding: 1.5rem;
	}

	.lab-stage.is-static .slab-item {
		position: relative;
		inset: auto;
		width: auto;
		height: 190px;
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { Draggable } from 'gsap/Draggable';
	import { InertiaPlugin } from 'gsap/InertiaPlugin';

	gsap.registerPlugin(ScrollTrigger, Draggable, InertiaPlugin);

	const section = document.getElementById('lab');
	const stage = section?.querySelector<HTMLElement>('[data-lab-stage]');

	if (section && stage) {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const items = gsap.utils.toArray<HTMLElement>('[data-slab-item]', section);
		const glasses = items.map((item) => item.firstElementChild as HTMLElement);
		const metas = gsap.utils.toArray<HTMLElement>('[data-slab-meta]', section);
		const reveals = gsap.utils.toArray<HTMLElement>('[data-lab-reveal]', section);

		const blurInput = section.querySelector<HTMLInputElement>('[data-lab-blur]')!;
		const alphaInput = section.querySelector<HTMLInputElement>('[data-lab-alpha]')!;
		const tintInput = section.querySelector<HTMLInputElement>('[data-lab-tint]')!;
		const blurOut = section.querySelector<HTMLElement>('[data-lab-blur-out]')!;
		const alphaOut = section.querySelector<HTMLElement>('[data-lab-alpha-out]')!;
		const tintOut = section.querySelector<HTMLElement>('[data-lab-tint-out]')!;
		const resetBtn = section.querySelector<HTMLButtonElement>('[data-lab-reset]')!;
		const scatterBtn = section.querySelector<HTMLButtonElement>('[data-lab-scatter]')!;

		const DEFAULTS = { blur: 24, alpha: 8, tint: 0 };

		const applyTokens = (blur: number, alpha: number, tint: number) => {
			stage.style.setProperty('--lab-blur', `${blur}px`);
			stage.style.setProperty('--lab-alpha', String(alpha / 100));
			stage.style.setProperty('--lab-tint', `${tint}deg`);
			blurOut.textContent = `${blur}px`;
			alphaOut.textContent = `${alpha}%`;
			tintOut.textContent = `${tint}°`;
			metas.forEach((meta) => {
				meta.textContent = `BLUR ${blur} / OP ${alpha}%`;
			});
		};

		blurInput.addEventListener('input', () =>
			applyTokens(Number(blurInput.value), Number(alphaInput.value), Number(tintInput.value))
		);
		alphaInput.addEventListener('input', () =>
			applyTokens(Number(blurInput.value), Number(alphaInput.value), Number(tintInput.value))
		);
		tintInput.addEventListener('input', () =>
			applyTokens(Number(blurInput.value), Number(alphaInput.value), Number(tintInput.value))
		);

		applyTokens(DEFAULTS.blur, DEFAULTS.alpha, DEFAULTS.tint);

		let draggables: Draggable[] = [];

		if (reduceMotion) {
			stage.classList.add('is-static');
			gsap.set(items, { clearProps: 'all' });
			gsap.set(glasses, { clearProps: 'all' });
			gsap.set(reveals, { clearProps: 'all', opacity: 1 });
		} else {
			draggables = Draggable.create(items, {
				type: 'x,y',
				bounds: stage,
				inertia: true,
				onPress() {
					const glass = this.target.firstElementChild as HTMLElement;
					glasses.forEach((el) => el.classList.remove('border-accent/60', 'is-pressed'));
					this.target.style.zIndex = '60';
					glass.classList.add('border-accent/60', 'is-pressed');
					gsap.to(glass, { scale: 1.04, duration: 0.45, ease: 'back.out(2)' });
				},
				onRelease() {
					const glass = this.target.firstElementChild as HTMLElement;
					glass.classList.remove('is-pressed');
					gsap.to(glass, { scale: 1, duration: 1.1, ease: 'elastic.out(1, 0.55)' });
				},
			}) as Draggable[];

			const quickX = glasses.map((glass) => gsap.quickTo(glass, 'x', { duration: 0.7, ease: 'power3' }));
			const quickY = glasses.map((glass) => gsap.quickTo(glass, 'y', { duration: 0.7, ease: 'power3' }));
			const maxDepth = items.length;

			stage.addEventListener('pointermove', (event) => {
				const rect = stage.getBoundingClientRect();
				const px = (event.clientX - rect.left) / rect.width - 0.5;
				const py = (event.clientY - rect.top) / rect.height - 0.5;
				items.forEach((item, i) => {
					const depth = Number(item.dataset.depth ?? i + 1) / maxDepth;
					quickX[i](px * 28 * depth);
					quickY[i](py * 28 * depth);
				});
			});

			stage.addEventListener('pointerleave', () => {
				quickX.forEach((q) => q(0));
				quickY.forEach((q) => q(0));
			});

			gsap.from(items, {
				x: () => gsap.utils.random(-300, 300),
				y: () => gsap.utils.random(-300, 300),
				rotation: () => gsap.utils.random(-20, 20),
				opacity: 0,
				duration: 1.4,
				ease: 'expo.out',
				stagger: 0.08,
				scrollTrigger: { trigger: section, start: 'top 85%', once: true },
			});

			gsap.from(reveals, {
				y: 40,
				opacity: 0,
				duration: 1.1,
				ease: 'expo.out',
				stagger: 0.06,
				scrollTrigger: { trigger: section, start: 'top 85%', once: true },
			});
		}

		const syncDraggables = () => draggables.forEach((d) => d.update());

		resetBtn.addEventListener('click', () => {
			blurInput.value = String(DEFAULTS.blur);
			alphaInput.value = String(DEFAULTS.alpha);
			tintInput.value = String(DEFAULTS.tint);
			applyTokens(DEFAULTS.blur, DEFAULTS.alpha, DEFAULTS.tint);
			if (reduceMotion) return;
			gsap.to(items, {
				x: 0,
				y: 0,
				rotation: 0,
				duration: 1.2,
				ease: 'elastic.out(1, 0.6)',
				stagger: 0.05,
				onComplete: syncDraggables,
			});
		});

		scatterBtn.addEventListener('click', () => {
			if (reduceMotion) return;
			gsap.to(items, {
				x: (_i, target) => {
					const el = target as HTMLElement;
					return gsap.utils.random(0, Math.max(0, stage.clientWidth - el.offsetLeft - el.offsetWidth));
				},
				y: (_i, target) => {
					const el = target as HTMLElement;
					return gsap.utils.random(0, Math.max(0, stage.clientHeight - el.offsetTop - el.offsetHeight));
				},
				rotation: 0,
				duration: 1,
				ease: 'power4.out',
				stagger: 0.04,
				onComplete: syncDraggables,
			});
		});
	}
</script>
