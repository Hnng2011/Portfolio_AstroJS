---
import { profile } from '../data/portfolio';
---

<section id="top" class="relative min-h-svh overflow-hidden">
	<canvas data-flow class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
	<div class="layer-grid pointer-events-none absolute inset-0"></div>
	<div
		class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-void to-transparent"
		aria-hidden="true"
	></div>

	<div class="reel-container relative flex min-h-svh flex-col justify-between pt-28 pb-10">
		<div data-hero-meta class="flex items-center gap-5">
			<span class="t-mono text-ash">01 — {profile.role}</span>
			<span class="h-px flex-1 bg-bone/15" aria-hidden="true"></span>
			<span class="t-mono text-ash">{profile.location}</span>
		</div>

		<h1 class="t-mega py-10 text-bone" data-hero-title aria-label="Phi Hung">
			<span class="mask-line"><span class="title-line block" data-chars="PHI">PHI</span></span>
			<span class="mask-line"
				><span class="title-line stroke-text block" data-chars="HUNG">HUNG</span></span
			>
		</h1>

		<div class="grid gap-10 pb-6 lg:grid-cols-12 lg:items-end">
			<div class="lg:col-span-6">
				<p class="t-mono mb-4 text-flame" data-scramble={profile.focus}>
					{profile.focus}
				</p>
				<p class="max-w-xl text-base leading-relaxed text-ash md:text-lg" data-hero-copy>
					{profile.tagline}
				</p>
			</div>
			<div class="flex gap-10 lg:col-span-4 lg:justify-end" data-hero-stats>
				<div>
					<p class="font-display text-4xl text-bone md:text-5xl" data-count="7">00</p>
					<p class="t-mono mt-2 text-dim">Projects</p>
				</div>
				<div>
					<p class="font-display text-4xl text-bone md:text-5xl" data-count="5">00</p>
					<p class="t-mono mt-2 text-dim">Teams</p>
				</div>
				<div>
					<p class="font-display text-4xl text-bone md:text-5xl" data-count="3">00</p>
					<p class="t-mono mt-2 text-dim">Years</p>
				</div>
			</div>
			<div class="hidden flex-col items-end gap-3 lg:col-span-2 lg:flex" aria-hidden="true">
				<span class="t-mono text-dim">Scroll</span>
				<span class="block h-14 w-px bg-gradient-to-b from-flame to-transparent" data-scroll-cue></span>
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap, ScrollTrigger, SplitText, scramble, reduced } from '../lib/motion';

	gsap.registerPlugin(SplitText);

	const canvas = document.querySelector('[data-flow]') as HTMLCanvasElement;
	const ctx = canvas.getContext('2d')!;
	let w = 0;
	let h = 0;
	let raf = 0;

	const resize = () => {
		const dpr = Math.min(devicePixelRatio, 2);
		w = canvas.clientWidth;
		h = canvas.clientHeight;
		canvas.width = w * dpr;
		canvas.height = h * dpr;
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
	};

	type P = { x: number; y: number; px: number; py: number; s: number; hue: number };
	let parts: P[] = [];

	const seed = () => {
		const n = Math.min(150, Math.floor((w * h) / 14000));
		parts = Array.from({ length: n }, () => {
			const x = Math.random() * w;
			const y = Math.random() * h;
			return { x, y, px: x, py: y, s: 0.4 + Math.random() * 1.1, hue: Math.random() };
		});
	};

	let t = 0;
	const field = (x: number, y: number) =>
		Math.sin(x * 0.0016 + t * 0.35) * Math.cos(y * 0.0013 - t * 0.22) * Math.PI * 2 +
		Math.sin((x + y) * 0.0007 + t * 0.12) * 1.6;

	const draw = () => {
		t += 0.006;
		ctx.globalCompositeOperation = 'destination-out';
		ctx.fillStyle = 'rgba(10,10,12,0.08)';
		ctx.fillRect(0, 0, w, h);
		ctx.globalCompositeOperation = 'lighter';
		for (const p of parts) {
			const a = field(p.x, p.y);
			p.px = p.x;
			p.py = p.y;
			p.x += Math.cos(a) * p.s;
			p.y += Math.sin(a) * p.s;
			if (p.x < -20 || p.x > w + 20 || p.y < -20 || p.y > h + 20) {
				p.x = Math.random() * w;
				p.y = Math.random() * h;
				p.px = p.x;
				p.py = p.y;
			}
			ctx.strokeStyle = p.hue > 0.86 ? 'rgba(255,59,31,0.5)' : 'rgba(236,232,223,0.16)';
			ctx.lineWidth = p.s * 0.7;
			ctx.beginPath();
			ctx.moveTo(p.px, p.py);
			ctx.lineTo(p.x, p.y);
			ctx.stroke();
		}
		raf = requestAnimationFrame(draw);
	};

	if (!reduced) {
		resize();
		seed();
		draw();
		addEventListener('resize', () => {
			resize();
			seed();
		});
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) cancelAnimationFrame(raf);
			else draw();
		});
	}

	const title = document.querySelector('[data-hero-title]')!;
	const lines = title.querySelectorAll('.title-line');
	const splits = Array.from(lines).map(
		(l) => new SplitText(l as HTMLElement, { type: 'chars' }),
	);

	if (!reduced) {
		const intro = () => {
			const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });
			tl.from('[data-hero-meta]', { y: 24, opacity: 0, duration: 0.9 }, 0.1)
				.from(
					splits.flatMap((s) => s.chars),
					{ yPercent: 110, rotate: 6, duration: 1.2, stagger: 0.05 },
					0.2,
				)
				.from('[data-hero-copy]', { y: 30, opacity: 0, duration: 0.9 }, 0.8)
				.from('[data-hero-stats] > div', { y: 30, opacity: 0, stagger: 0.1, duration: 0.8 }, 0.9);
		};
		if (document.querySelector('#preloader')) {
			document.addEventListener('reel:ready', intro, { once: true });
		} else {
			intro();
		}

		document.querySelectorAll('[data-scramble]').forEach((el) => {
			const text = (el as HTMLElement).dataset.scramble!;
			document.addEventListener(
				'reel:ready',
				() => setTimeout(() => scramble(el as HTMLElement, text, 1.4), 700),
				{ once: true },
			);
		});

		document.querySelectorAll('[data-count]').forEach((el) => {
			const target = Number((el as HTMLElement).dataset.count);
			const obj = { n: 0 };
			document.addEventListener(
				'reel:ready',
				() =>
					gsap.to(obj, {
						n: target,
						duration: 1.6,
						delay: 1,
						ease: 'power2.out',
						onUpdate: () => {
							el.textContent = String(Math.round(obj.n)).padStart(2, '0');
						},
					}),
				{ once: true },
			);
		});

		gsap.to(title, {
			yPercent: -18,
			ease: 'none',
			scrollTrigger: { trigger: '#top', start: 'top top', end: 'bottom top', scrub: 0.6 },
		});
		gsap.to(canvas, {
			scale: 1.15,
			opacity: 0.4,
			ease: 'none',
			scrollTrigger: { trigger: '#top', start: 'top top', end: 'bottom top', scrub: 0.6 },
		});
		gsap.to('[data-scroll-cue]', { scaleY: 0.3, transformOrigin: 'top', repeat: -1, yoyo: true, duration: 1, ease: 'power2.inOut' });
	}
</script>
