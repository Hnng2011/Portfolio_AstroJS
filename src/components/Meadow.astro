---
let seed = 11;
const rnd = () => {
	seed = (seed * 9301 + 49297) % 233280;
	return seed / 233280;
};

const tufts = Array.from({ length: 70 }, () => {
	const y = 96 + rnd() * 250;
	return { x: rnd() * 1600, y, k: 0.6 + ((y - 96) / 250) * 0.9 };
});
const daisies = Array.from({ length: 18 }, () => {
	const y = 110 + rnd() * 230;
	return { x: 40 + rnd() * 1520, y, k: 0.55 + ((y - 110) / 230) * 0.8 };
});
const buds = Array.from({ length: 16 }, () => {
	const y = 100 + rnd() * 240;
	return { x: rnd() * 1600, y, k: 0.5 + ((y - 100) / 240) * 0.8, c: rnd() > 0.5 ? '#ef8f6f' : '#b49ad6' };
});
const petals = [0, 60, 120, 180, 240, 300];
const butterflies = [
	['#ef8f6f', '#f2a541'],
	['#7aa6d9', '#b49ad6'],
];
const clouds = [
	{ top: 22, scale: 1, speed: 150, delay: -40 },
	{ top: 33, scale: 0.7, speed: 190, delay: -120 },
	{ top: 19, scale: 0.55, speed: 230, delay: -170 },
];
// Birds perched on the trees: position in the meadow drawing, colour and facing. They sit still and boil with it.
const birds = [
	{ x: 1376, y: -82, color: '#f2a541', flip: false },
	{ x: 1438, y: 9, color: '#7aa6d9', flip: true },
	{ x: 238, y: -42, color: '#ef8f6f', flip: false },
];
// The drawings are inked three times, one per still frame of the boil (doodle-frame-1..3 in the layout).
const frames = [0, 1, 2];

// The hill tops as chains of cubic Béziers, shared by the fills, a second pencil pass and the hatching.
const backTop = [[-20, 66], [180, 14], [400, 24], [600, 52], [800, 80], [1020, 22], [1220, 40], [1420, 58], [1520, 6], [1620, 30]];
const frontTop = [[-20, 78], [160, 44], [360, 46], [520, 70], [680, 94], [860, 92], [1040, 66], [1220, 40], [1380, 40], [1620, 70]];
const curve = (p: number[][]) => `M${p[0]}C${p.slice(1).join(' ')}`;
const bez = (a: number, b: number, c: number, d: number, t: number) =>
	(1 - t) ** 3 * a + 3 * (1 - t) ** 2 * t * b + 3 * (1 - t) * t ** 2 * c + t ** 3 * d;
// How high a hill top is at x: find its segment, then bisect for t.
const crest = (p: number[][], x: number) => {
	const i = p.findIndex((q, k) => k % 3 === 0 && k > 0 && q[0] >= x) - 3;
	const [a, b, c, d] = p.slice(i, i + 4);
	let lo = 0;
	let hi = 1;
	for (let k = 0; k < 20; k++) {
		const t = (lo + hi) / 2;
		if (bez(a[0], b[0], c[0], d[0], t) < x) lo = t;
		else hi = t;
	}
	return bez(a[1], b[1], c[1], d[1], lo);
};
// Pencil hatching down a hill's shadow side: a few little clusters of strokes leaning right, hung just under its top.
const hatch = (p: number[][], from: number, to: number) => {
	let d = '';
	for (let x = from; x < to; x += 40 + rnd() * 36) {
		const n = 3 + Math.floor(rnd() * 3);
		for (let j = 0; j < n; j++) {
			const hx = x + j * (5 + rnd() * 2);
			const l = (j === 0 || j === n - 1 ? 5 : 8) + rnd() * 5;
			const y = crest(p, hx) + 2.5 + rnd() * 2;
			d += `M${(hx - l * 0.9).toFixed(1)} ${(y + l * 0.76).toFixed(1)}L${hx.toFixed(1)} ${y.toFixed(1)}`;
		}
	}
	return d;
};
const backHatch = hatch(backTop, 350, 600) + hatch(backTop, 1120, 1280);
const frontHatch = hatch(frontTop, 390, 680) + hatch(frontTop, 1340, 1460);
// Ground marks: short contour strokes and little looped scribbles, bigger towards the front like the tufts.
const marks = Array.from({ length: 16 }, () => {
	const y = 112 + rnd() * 220;
	return { x: rnd() * 1600, y, w: 16 + rnd() * 18, k: 0.6 + ((y - 112) / 220) * 0.8 };
});
const scribbles = Array.from({ length: 8 }, () => {
	const y = 130 + rnd() * 200;
	const loops = 's5-5 4-6s-4 0-3 3 4 3 7 1'.repeat(1 + Math.floor(rnd() * 2));
	return { x: rnd() * 1600, y, k: 0.7 + ((y - 130) / 200) * 0.7, d: `c3-1 6-4 5-6s-4 0-3 3 4 3 7 1${loops}` };
});
// Tree crowns and bushes, each with hatching kept inside its right (shadow) side.
const crowns = {
	big: 'M0-150c-30 0-44 22-40 40-22 6-26 34-8 46 6 14 30 18 44 8 14 10 40 6 46-10 18-12 14-40-8-46 4-20-12-38-34-38z',
	small: 'M-2-146c-26 2-40 20-36 38-20 6-24 32-6 44 6 12 28 16 42 6 14 10 38 6 44-10 16-12 12-38-8-44 2-20-14-36-36-34z',
};
const crownHatch = 'M16-56l24-20M24-58l24-20M32-62l18-15M30-76l18-15M34-90l11-9';
const bushes = [
	{ d: 'M30 80c-6-26 24-38 40-24 10-20 44-12 42 12 18 0 26 18 14 30h-88c-14-2-16-14-8-18z', hatch: 'M94 97l20-16M102 98l20-16M110 98l18-15M117 90l12-10', curl: 'M54 70q6-8 14-6' },
	{ d: 'M1480 70c-4-24 26-34 40-20 12-18 44-8 40 14 16 2 22 20 10 28h-80c-14-4-14-16-10-22z', hatch: 'M1538 91l20-16M1546 92l20-16M1554 92l18-15M1561 85l12-10', curl: 'M1502 60q6-7 13-5' },
];
// A bee's body, drawn twice: under its stripes as the fill and over them as the outline, and as their clip.
const bee = 'M10 23c-1-6 5-11 13-11 8 0 14 4 13 10s-6 9-13 9c-7 0-12-3-13-8z';
// The art is one flat run of paths with no transforms, opacity groups or clips: each of those would split
// the meadow into more paint chunks, and the page re-layers every chunk whenever anything repaints.
const f = (v: number) => +v.toFixed(2);
// Moves a path whose only absolute command is its first M (for the second pencil passes).
const shift = (d: string, dx: number, dy: number) => d.replace(/^M(-?[\d.]+) ?(-?[\d.]+)/, (_, x, y) => `M${f(+x + dx)} ${f(+y + dy)}`);
// Places a doodle written in relative commands from 0,0 at x,y, scaled by k.
const place = (d: string, x: number, y: number, k: number) =>
	`M${f(x)} ${f(y)}${d.replace(/-?(?:\d+\.?\d*|\.\d+)/g, (n) => `${f(+n * k)}`)}`;
// A daisy's six petals as one path, each ellipse written as two arcs from the flower's middle to its tip.
const petalPath = (x: number, y: number, k: number) =>
	petals
		.map((a) => {
			const dx = Math.sin((a * Math.PI) / 180) * 14 * k;
			const dy = -Math.cos((a * Math.PI) / 180) * 14 * k;
			const arc = `A${f(4 * k)} ${f(7 * k)} ${a} 0 1`;
			return `M${f(x)} ${f(y - 20 * k)}${arc} ${f(x + dx)} ${f(y - 20 * k + dy)}${arc} ${f(x)} ${f(y - 20 * k)}z`;
		})
		.join('');
const cloud = 'M30 84c-18 0-26-18-14-30-6-20 16-34 32-24 6-22 38-28 52-10 14-18 46-14 52 8 22-4 38 16 28 34 16 6 12 22-4 22z';
---

<div class="clouds" data-clouds aria-hidden="true">
	{
		clouds.map((c) => (
			<div class="cloud" style={`--top: ${c.top}vh; --s: ${c.scale}; --t: ${c.speed}s; --d: ${c.delay}s`}>
				{frames.map((n) => (
					<svg class="boil" style={`--f: ${n}`} viewBox="0 0 220 96">
						<use href="#cloud-art" filter={`url(#doodle-frame-${n + 1})`} />
					</svg>
				))}
			</div>
		))
	}
</div>

<div class="meadow" data-meadow aria-hidden="true">
	<svg class="ink-defs" width="0" height="0" focusable="false">
		<defs>
			<clipPath id="meadow-bee"><path d={bee} /></clipPath>

			<g id="cloud-art" fill="#fff" stroke="#17130f" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
				<path d={cloud} />
				<path d="M60 62q8-6 18-2M128 56q8-6 18 0" fill="none" stroke-width="2" stroke-opacity="0.4" />
				<path d="M118 83l8-11M130 83l8-11M142 83l8-11M154 83l8-11M166 82l7-10" fill="none" stroke-width="1.6" stroke-opacity="0.3" />
				<path d={shift(cloud, 2.5, -2.2)} fill="none" stroke-width="1.4" stroke-dasharray="70 120 46 600" stroke-opacity="0.45" />
			</g>

			<g id="meadow-art" fill="none" stroke="#17130f" stroke-linecap="round" stroke-linejoin="round">
				<path d={`${curve(backTop)}V110H-20z`} fill="#e9edd6" stroke-width="2.4" />
				<path d={backHatch} stroke-width="1.5" stroke-opacity="0.28" />
				<path d={curve(backTop.map(([x, y]) => [x + 3, y - 2.6]))} stroke-width="1.4" stroke-dasharray="230 150 120 260 300 190 160 420" stroke-opacity="0.45" />
				<g transform="translate(1390 64)">
					<path d="M-7 0v-62h14V0" fill="#c08a5a" stroke-width="2.6" />
					<path d="M-1-50q2 6 0 12M3-30v-7" stroke-width="1.6" stroke-opacity="0.45" />
					<path d="M7-34q30-6 52-30" stroke="#c08a5a" stroke-width="7" />
					<path d="M7-34q30-6 52-30" stroke-width="2.4" stroke-opacity="0.6" />
					<path d={crowns.big} fill="#8fbf7f" stroke-width="2.8" />
					<path d={crownHatch} stroke-width="1.6" stroke-opacity="0.32" />
					<path d={shift(crowns.big, -2.5, -2.2)} stroke-width="1.4" stroke-dasharray="66 150 34 400" stroke-opacity="0.45" />
					<path d="M-18-110q6-8 14-6M14-84q8-4 14 2" stroke-width="2.2" />
				</g>
				<g transform="translate(236 70) scale(0.78)">
					<path d="M-7 0v-60h14V0" fill="#c08a5a" stroke-width="3" />
					<path d="M-1-48q2 6 0 12" stroke-width="2" stroke-opacity="0.45" />
					<path d={crowns.small} fill="#9cc98a" stroke-width="3.2" />
					<path d={crownHatch} stroke-width="2" stroke-opacity="0.32" />
					<path d={shift(crowns.small, -2.5, -2.2)} stroke-width="1.8" stroke-dasharray="60 160 30 400" stroke-opacity="0.45" />
					<path d="M-16-106q6-8 14-6" stroke-width="2.6" />
				</g>
				{
					birds.map((b) => (
						<g transform={`translate(${b.x} ${b.y}) scale(${b.flip ? -1 : 1} 1)`}>
							<path d="M-3-1l-.5 4M3-1l.5 4M-5.5 3.2h4M1.5 3.4h4" stroke-width="1.8" />
							<path d="M-9-9c-4-2-8-4-11-5 0 3 1 6 3 9 2 0 5-1 8-4z" fill={b.color} stroke-width="1.8" />
							<path d="M-10-8c0-6 5-9 11-9 6 0 9 4 9 9s-5 7-10 7c-6 0-10-2-10-7z" fill={b.color} stroke-width="2" />
							<path d="M-4-3l3-3M0-2l3-3M4-3l2.5-2.5" stroke-width="1.3" stroke-opacity="0.4" />
							<path d="M-6-11c2 5 7 6 10 2" stroke-width="1.6" />
							<path d="M1-17c0-4 3-7 7-7 3 0 6 3 6 6 0 4-3 7-7 7-3 0-6-2-6-6z" fill={b.color} stroke-width="2" />
							<path d="M9-18.5h.1" stroke-width="3" />
							<path d="M13.5-18c2 0 4 1 5.5 1.8-1.5.8-3.5 1.4-5.5 1.4z" fill="#f2a541" stroke-width="1.4" />
						</g>
					))
				}

				<path d={`${curve(frontTop)}V370H-20z`} fill="#dfe7c4" stroke-width="3" />
				<path d={frontHatch} stroke-width="1.5" stroke-opacity="0.28" />
				<path d={curve(frontTop.map(([x, y]) => [x - 4, y + 3]))} stroke-width="1.4" stroke-dasharray="180 240 260 130 90 300 220 400" stroke-opacity="0.4" />
				{
					bushes.map((b) => (
						<>
							<path d={b.d} fill="#a8cc93" stroke-width="2.6" />
							<path d={b.hatch} stroke-width="1.5" stroke-opacity="0.32" />
							<path d={shift(b.d, -2, -2.2)} stroke-width="1.3" stroke-dasharray="54 300" stroke-opacity="0.45" />
							<path d={b.curl} stroke-width="2" />
						</>
					))
				}

				{
					marks.map(({ x, y, w, k }) => (
						<path d={`M${x} ${y}q${w / 2} ${-4 * k} ${w} 0`} stroke="#6f9a5e" stroke-width={1.2 + k * 0.6} stroke-opacity="0.6" />
					))
				}
				{
					scribbles.map(({ x, y, k, d }) => (
						<path d={place(d, x, y, k)} stroke="#6f9a5e" stroke-width={f(1.7 * k)} stroke-opacity="0.7" />
					))
				}
				{
					tufts.map(({ x, y, k }) => (
						<path
							d={`M${x} ${y}l${-5 * k} ${-12 * k}M${x} ${y}l${-0.5 * k} ${-16 * k}M${x} ${y}l${5 * k} ${-12 * k}`}
							stroke="#6f9a5e"
							stroke-width={1.6 + k}
						/>
					))
				}
				{
					buds.map(({ x, y, k, c }) => (
						<>
							<path d={place('v-14', x, y, k)} stroke="#6f9a5e" stroke-width={f(2.4 * k)} />
							<path d={place('q0-10 5-10 5 0 5 10z', x - 5 * k, y - 14 * k, k)} fill={c} stroke-width={f(2 * k)} />
						</>
					))
				}
				{
					daisies.map(({ x, y, k }) => (
						<>
							<path d={place('v-16', x, y, k)} stroke="#6f9a5e" stroke-width={f(2.4 * k)} />
							<path d={petalPath(x, y, k)} fill="#fbf7ef" stroke-width={f(1.8 * k)} />
							<circle cx={f(x)} cy={f(y - 20 * k)} r={f(4.5 * k)} fill="#f2a541" stroke-width={f(1.8 * k)} />
						</>
					))
				}
			</g>
		</defs>
	</svg>
	{
		frames.map((n) => (
			<svg class="boil" style={`--f: ${n}`} viewBox="0 0 1600 360" preserveAspectRatio="xMidYMax slice">
				<use href="#meadow-art" filter={`url(#doodle-frame-${n + 1})`} />
			</svg>
		))
	}
</div>

<div class="flyers" data-flyers aria-hidden="true">
	{
		butterflies.map(([top, bottom]) => (
			<div class="critter butterfly" data-critter="butterfly">
				<svg class="wings" viewBox="0 0 52 42" fill="none" stroke="#17130f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M25 13c-4-7-13-11-19-8-4 3-3 11 3 14 5 2 12 1 16-3z" fill={top} />
					<path d="M25 19c-5 0-11 3-12 8-1 4 3 7 7 5 4-2 6-7 5-13z" fill={bottom} />
					<path d="M27 13c4-7 13-12 19-9 4 3 3 12-3 14-5 2-12 1-16-2z" fill={top} />
					<path d="M27 19c5 0 12 3 12 9 0 4-3 6-7 4-4-2-6-7-5-13z" fill={bottom} />
					<path d="M10 9c0-2 3-3 4-1s-1 4-3 3-1-1-1-2zM39 8c1-2 4-1 4 1s-2 3-3 2-1-2-1-3z" fill={bottom} stroke-width="1.4" />
					<path d="M15 18l4-5M19 18l4-5M37 18l-4-5M33 18l-4-5" stroke-width="1.3" stroke-opacity="0.4" />
				</svg>
				<svg viewBox="0 0 52 42" fill="none" stroke="#17130f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M24.6 11.5c0-2.4 3-2.4 3 0l.8 20.5c0 3-4.6 3-4.6 0z" fill="#17130f" stroke-width="1.6" />
					<path d="M25 11c-1-5-2-8-6-10.5M27 11c1-5 3-8 6.5-10" stroke-width="1.8" />
					<path d="M18.8 .4h.1M33.6 .9h.1" stroke-width="3.6" />
				</svg>
			</div>
		))
	}
	{
		[0, 1, 2].map(() => (
			<div class="critter bee" data-critter="bee">
				<svg class="wings" viewBox="0 0 46 36" fill="none" stroke="#17130f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M19 17c-5-1-8-8-5-13 3-3 8 0 8 6 0 3-1 6-3 7z" fill="#fbf7ef" fill-opacity="0.9" />
					<path d="M25 16c-2-4 0-11 4-11 4 1 4 8 0 10-1 1-3 1-4 1z" fill="#fbf7ef" fill-opacity="0.9" />
					<path d="M17 13q0-4 1-6M27 12q1-3 2-4" stroke-width="1.2" stroke-opacity="0.4" />
				</svg>
				<svg viewBox="0 0 46 36" fill="none" stroke="#17130f" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M2 22q-2-4 2-6" stroke-dasharray="2 3" stroke-opacity="0.5" />
					<path d="M10.5 22.5l-5.5 1 5.5 2.5z" fill="#17130f" stroke-width="1.6" />
					<path d={bee} fill="#f6c64b" />
					<g clip-path="url(#meadow-bee)">
						<path d="M18 12q-3 9 0 20M25 11q-3 10 .5 21" stroke-width="3.4" />
						<path d="M14 29l3-3M29 31l3-3M33 29l3-3" stroke-width="1.3" stroke-opacity="0.4" />
					</g>
					<path d={bee} />
					<path d="M32 19.5h.1" stroke-width="3.6" />
					<path d="M32.5 24.5q2 .8 3.2-1.2" stroke-width="1.4" />
				</svg>
			</div>
		))
	}
</div>

<style>
	.clouds {
		position: absolute;
		inset: 0 0 auto;
		height: 52vh;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
	}

	.cloud {
		position: absolute;
		top: var(--top);
		left: 0;
		width: calc(220px * var(--s));
		height: calc(96px * var(--s));
		will-change: translate;
		animation: cloud-drift var(--t) linear var(--d) infinite;
	}

	@keyframes cloud-drift {
		from {
			translate: -260px 0;
		}
		to {
			translate: calc(100vw + 40px) 0;
		}
	}

	/* The lines boil like the character's, but cheaply: each drawing is three copies, filtered once with
	   still frames of the same ink, and only which copy shows changes (an opacity step on the compositor). */
	.boil {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
		will-change: opacity;
		animation: ink-boil 0.375s steps(1) calc(var(--f) * -0.125s) infinite;
	}

	.boil + .boil {
		opacity: 0;
	}

	/* A hair over a third, so a frame never falls between two copies and shows bare paper. */
	@keyframes ink-boil {
		0% {
			opacity: 1;
		}
		33.4%,
		100% {
			opacity: 0;
		}
	}

	.ink-defs {
		position: absolute;
	}

	.meadow {
		position: absolute;
		inset: auto 0 0;
		height: 36vh;
		z-index: 0;
		pointer-events: none;
	}

	.flyers {
		position: absolute;
		inset: 0;
		z-index: 6;
		pointer-events: none;
		overflow: hidden;
	}

	.critter {
		position: absolute;
		top: 0;
		left: 0;
		will-change: transform;
	}

	/* Wings and body are separate drawings, so the flap is a compositor transform rather than a repaint.
	   Both boil with the character's ink. */
	.critter svg {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
		filter: url(#doodle-rough);
	}

	.butterfly {
		width: 50px;
		height: 40px;
	}

	.bee {
		width: 34px;
		height: 27px;
	}

	.wings {
		transform-origin: 50% 48%;
		animation: critter-flap 0.22s ease-in-out infinite alternate;
	}

	.bee .wings {
		transform-origin: 50% 44%;
		animation: critter-buzz 0.06s linear infinite alternate;
	}

	@keyframes critter-flap {
		from {
			scale: 1 1;
		}
		to {
			scale: 0.25 1;
		}
	}

	@keyframes critter-buzz {
		from {
			scale: 1 1;
		}
		to {
			scale: 1 0.5;
		}
	}

	@media (max-width: 767px) {
		.meadow {
			height: 30vh;
		}

		.cloud {
			width: calc(150px * var(--s));
			height: calc(66px * var(--s));
		}
	}

	/* No boil: the first inking stays, still wobbly. */
	@media (prefers-reduced-motion: reduce) {
		.cloud {
			animation: none;
			translate: calc(var(--top) * 4) 0;
		}

		.boil {
			animation: none;
		}
	}
</style>
