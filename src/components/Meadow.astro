---
let seed = 11;
const rnd = () => {
	seed = (seed * 9301 + 49297) % 233280;
	return seed / 233280;
};

const tufts = Array.from({ length: 70 }, () => {
	const y = 96 + rnd() * 250;
	return { x: rnd() * 1600, y, k: 0.6 + ((y - 96) / 250) * 0.9 };
});
const daisies = Array.from({ length: 18 }, () => {
	const y = 110 + rnd() * 230;
	return { x: 40 + rnd() * 1520, y, k: 0.55 + ((y - 110) / 230) * 0.8 };
});
const buds = Array.from({ length: 16 }, () => {
	const y = 100 + rnd() * 240;
	return { x: rnd() * 1600, y, k: 0.5 + ((y - 100) / 240) * 0.8, c: rnd() > 0.5 ? '#ef8f6f' : '#b49ad6' };
});
const petals = [0, 60, 120, 180, 240, 300];
const butterflies = [
	['#ef8f6f', '#f2a541'],
	['#7aa6d9', '#b49ad6'],
];
const clouds = [
	{ top: 22, scale: 1, speed: 150, delay: -40 },
	{ top: 33, scale: 0.7, speed: 190, delay: -120 },
	{ top: 19, scale: 0.55, speed: 230, delay: -170 },
];
// Birds perched on the trees: position in the meadow drawing, colour, facing and animation offset.
const birds = [
	{ x: 1376, y: -82, color: '#f2a541', flip: false, delay: 0 },
	{ x: 1438, y: 9, color: '#7aa6d9', flip: true, delay: -1.7 },
	{ x: 238, y: -42, color: '#ef8f6f', flip: false, delay: -3.1 },
];
---

<div class="clouds" data-clouds aria-hidden="true">
	{
		clouds.map((c) => (
			<svg
				class="cloud"
				style={`--top: ${c.top}vh; --s: ${c.scale}; --t: ${c.speed}s; --d: ${c.delay}s`}
				viewBox="0 0 220 96"
				fill="#fff"
				stroke="#17130f"
				stroke-width="2.6"
				stroke-linejoin="round"
			>
				<path d="M30 84c-18 0-26-18-14-30-6-20 16-34 32-24 6-22 38-28 52-10 14-18 46-14 52 8 22-4 38 16 28 34 16 6 12 22-4 22z" />
				<path d="M60 62q8-6 18-2M128 56q8-6 18 0" stroke-width="2" opacity="0.4" />
			</svg>
		))
	}
</div>

<div class="meadow" data-meadow aria-hidden="true">
	<svg
		viewBox="0 0 1600 360"
		preserveAspectRatio="xMidYMax slice"
		fill="none"
		stroke="#17130f"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path
			d="M-20 66C180 14 400 24 600 52s420-30 620-12 300-34 400-10v80H-20z"
			fill="#e9edd6"
			stroke-width="2.4"
		/>
		<g transform="translate(1390 64)">
			<path d="M-7 0v-62h14V0" fill="#c08a5a" stroke-width="2.6" />
			<path d="M7-34q30-6 52-30" stroke="#c08a5a" stroke-width="7" />
			<path d="M7-34q30-6 52-30" stroke-width="2.4" opacity="0.6" />
			<path
				d="M0-150c-30 0-44 22-40 40-22 6-26 34-8 46 6 14 30 18 44 8 14 10 40 6 46-10 18-12 14-40-8-46 4-20-12-38-34-38z"
				fill="#8fbf7f"
				stroke-width="2.8"
			/>
			<path d="M-18-110q6-8 14-6M14-84q8-4 14 2" stroke-width="2.2" />
		</g>
		<g transform="translate(236 70) scale(0.78)">
			<path d="M-7 0v-60h14V0" fill="#c08a5a" stroke-width="3" />
			<path
				d="M-2-146c-26 2-40 20-36 38-20 6-24 32-6 44 6 12 28 16 42 6 14 10 38 6 44-10 16-12 12-38-8-44 2-20-14-36-36-34z"
				fill="#9cc98a"
				stroke-width="3.2"
			/>
			<path d="M-16-106q6-8 14-6" stroke-width="2.6" />
		</g>

		<path
			d="M-20 78C160 44 360 46 520 70s340 22 520-4 340-26 580 4v300H-20z"
			fill="#dfe7c4"
			stroke-width="3"
		/>
		<path d="M30 80c-6-26 24-38 40-24 10-20 44-12 42 12 18 0 26 18 14 30H38c-14-2-16-14-8-18z" fill="#a8cc93" stroke-width="2.6" />
		<path d="M1480 70c-4-24 26-34 40-20 12-18 44-8 40 14 16 2 22 20 10 28h-80c-14-4-14-16-10-22z" fill="#a8cc93" stroke-width="2.6" />

		{
			tufts.map(({ x, y, k }) => (
				<path
					d={`M${x} ${y}l${-5 * k} ${-12 * k}M${x} ${y}l${-0.5 * k} ${-16 * k}M${x} ${y}l${5 * k} ${-12 * k}`}
					stroke="#6f9a5e"
					stroke-width={1.6 + k}
				/>
			))
		}
		{
			buds.map(({ x, y, k, c }) => (
				<g transform={`translate(${x} ${y}) scale(${k})`}>
					<path d="M0 0v-14" stroke="#6f9a5e" stroke-width="2.4" />
					<path d="M-5-14q0-10 5-10 5 0 5 10z" fill={c} stroke-width="2" />
				</g>
			))
		}
		{
			daisies.map(({ x, y, k }) => (
				<g transform={`translate(${x} ${y}) scale(${k})`}>
					<path d="M0 0v-16" stroke="#6f9a5e" stroke-width="2.4" />
					{petals.map((a) => (
						<ellipse cx="0" cy="-27" rx="4" ry="7" fill="#fbf7ef" stroke-width="1.8" transform={`rotate(${a} 0 -20)`} />
					))}
					<circle cx="0" cy="-20" r="4.5" fill="#f2a541" stroke-width="1.8" />
				</g>
			))
		}
	</svg>
	<svg
		class="meadow-birds"
		viewBox="0 0 1600 360"
		preserveAspectRatio="xMidYMax slice"
		fill="none"
		stroke="#17130f"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		{
			birds.map((b) => (
				<g transform={`translate(${b.x} ${b.y}) scale(${b.flip ? -1 : 1} 1)`}>
					<g class="bird" data-perch style={`--d: ${b.delay}s`}>
						<path d="M-3-1v4M3-1v4" stroke-width="1.8" />
						<g class="bird-body">
							<path class="bird-tail" d="M-9-9l-11-5 3 9z" fill={b.color} stroke-width="1.8" />
							<ellipse cx="0" cy="-9" rx="10" ry="8" fill={b.color} stroke-width="2" />
							<path d="M-5-10q4 6 9 2" stroke-width="1.6" />
							<g class="bird-head">
								<circle cx="7" cy="-17" r="6.5" fill={b.color} stroke-width="2" />
								<circle cx="9" cy="-18" r="1.4" fill="#17130f" stroke="none" />
								<path d="M13-17l6 1.5-6 1.6z" fill="#f2a541" stroke-width="1.4" />
							</g>
						</g>
					</g>
				</g>
			))
		}

	</svg>
</div>

<div class="sky-birds" data-sky-birds aria-hidden="true">
	{
		birds.map((b) => (
			<svg class="sky-bird" data-sky-bird viewBox="-24 -30 48 40" fill="none" stroke="#17130f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M-9-9l-11-5 3 9z" fill={b.color} stroke-width="1.8" />
				<ellipse cx="0" cy="-9" rx="10" ry="7" fill={b.color} />
				<path class="sky-wing" d="M-4-12q4-16 14-12-2 8-10 12z" fill={b.color} />
				<circle cx="8" cy="-15" r="6" fill={b.color} />
				<circle cx="10" cy="-16" r="1.4" fill="#17130f" stroke="none" />
				<path d="M13-15l6 1.5-6 1.6z" fill="#f2a541" stroke-width="1.4" />
			</svg>
		))
	}
</div>

<div class="flyers" data-flyers aria-hidden="true">
	{
		butterflies.map(([top, bottom]) => (
			<div class="critter butterfly" data-critter="butterfly">
				<svg viewBox="0 0 52 42" fill="none" stroke="#17130f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<g class="wing">
						<ellipse cx="15" cy="16" rx="11" ry="9" fill={top} />
						<ellipse cx="18" cy="29" rx="7" ry="6" fill={bottom} />
					</g>
					<g class="wing wing-r">
						<ellipse cx="37" cy="16" rx="11" ry="9" fill={top} />
						<ellipse cx="34" cy="29" rx="7" ry="6" fill={bottom} />
					</g>
					<path d="M26 10v24" stroke-width="3" />
					<path d="M26 10q-3-6-8-7M26 10q3-6 8-7" />
				</svg>
			</div>
		))
	}
	{
		[0, 1, 2].map(() => (
			<div class="critter bee" data-critter="bee">
				<svg viewBox="0 0 46 36" fill="none" stroke="#17130f" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M2 22q-2-4 2-6" stroke-dasharray="2 3" opacity="0.5" />
					<g class="wing">
						<ellipse cx="18" cy="10" rx="6" ry="8" fill="#fbf7ef" opacity="0.9" />
						<ellipse cx="27" cy="9" rx="5" ry="7" fill="#fbf7ef" opacity="0.9" />
					</g>
					<ellipse cx="23" cy="22" rx="13" ry="9" fill="#f6c64b" />
					<path d="M19 14v16M25 13v18" stroke-width="3" />
					<path d="M10 22l-5 1 5 2" fill="#17130f" />
					<circle cx="32" cy="20" r="1.8" fill="#17130f" stroke="none" />
				</svg>
			</div>
		))
	}
</div>

<style>
	.clouds {
		position: absolute;
		inset: 0 0 auto;
		height: 52vh;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
	}

	.cloud {
		position: absolute;
		top: var(--top);
		left: 0;
		width: calc(220px * var(--s));
		height: calc(96px * var(--s));
		overflow: visible;
		filter: url(#doodle-ink);
		will-change: translate;
		animation: cloud-drift var(--t) linear var(--d) infinite;
	}

	@keyframes cloud-drift {
		from {
			translate: -260px 0;
		}
		to {
			translate: calc(100vw + 40px) 0;
		}
	}

	.meadow {
		position: absolute;
		inset: auto 0 0;
		height: 36vh;
		z-index: 0;
		pointer-events: none;
	}

	.meadow svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
		filter: url(#doodle-ink);
	}

	.meadow-birds {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.bird {
		transition: opacity 0.15s linear;
	}

	.bird:global(.is-away) {
		opacity: 0;
	}

	.sky-birds {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		overflow: hidden;
	}

	.sky-bird {
		position: absolute;
		top: 0;
		left: 0;
		width: 40px;
		height: 34px;
		overflow: visible;
		visibility: hidden;
		will-change: transform;
	}

	.sky-bird :global(.sky-wing) {
		transform-box: fill-box;
		transform-origin: 20% 100%;
		animation: sky-flap 0.18s ease-in-out infinite alternate;
	}

	@keyframes sky-flap {
		from {
			scale: 1 1;
		}
		to {
			scale: 1 -0.9;
		}
	}

	.bird,
	.bird-body,
	.bird-head,
	.bird-tail {
		transform-box: fill-box;
	}

	.bird {
		transform-origin: 50% 100%;
		animation: bird-hop 7s ease-in-out var(--d) infinite;
	}

	.bird-body {
		transform-origin: 40% 100%;
		animation: bird-peck 5.2s ease-in-out var(--d) infinite;
	}

	.bird-head {
		transform-origin: 30% 70%;
		animation: bird-look 3.6s ease-in-out var(--d) infinite;
	}

	.bird-tail {
		transform-origin: 100% 40%;
		animation: bird-flick 2.3s ease-in-out var(--d) infinite;
	}

	@keyframes bird-hop {
		0%,
		70%,
		82%,
		100% {
			translate: 0 0;
		}
		74%,
		78% {
			translate: 0 -7px;
		}
	}

	@keyframes bird-peck {
		0%,
		40%,
		52%,
		60%,
		100% {
			rotate: 0deg;
		}
		46%,
		56% {
			rotate: 32deg;
		}
	}

	@keyframes bird-look {
		0%,
		30%,
		100% {
			rotate: 0deg;
		}
		38%,
		60% {
			rotate: -16deg;
		}
		68%,
		88% {
			rotate: 10deg;
		}
	}

	@keyframes bird-flick {
		0%,
		70%,
		100% {
			rotate: 0deg;
		}
		78% {
			rotate: -18deg;
		}
		86% {
			rotate: 6deg;
		}
	}

	.flyers {
		position: absolute;
		inset: 0;
		z-index: 6;
		pointer-events: none;
		overflow: hidden;
	}

	.critter {
		position: absolute;
		top: 0;
		left: 0;
		will-change: transform;
	}

	.critter svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.butterfly {
		width: 50px;
		height: 40px;
	}

	.bee {
		width: 34px;
		height: 27px;
	}

	.wing {
		transform-box: view-box;
		transform-origin: 26px 20px;
		animation: critter-flap 0.16s ease-in-out infinite alternate;
	}

	.butterfly .wing {
		animation-duration: 0.22s;
	}

	.bee .wing {
		transform-origin: 23px 16px;
		animation: critter-buzz 0.06s linear infinite alternate;
	}

	@keyframes critter-flap {
		from {
			scale: 1 1;
		}
		to {
			scale: 0.25 1;
		}
	}

	@keyframes critter-buzz {
		from {
			scale: 1 1;
		}
		to {
			scale: 1 0.5;
		}
	}

	@media (max-width: 767px) {
		.meadow {
			height: 30vh;
		}

		.cloud {
			width: calc(150px * var(--s));
			height: calc(66px * var(--s));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cloud {
			animation: none;
			translate: calc(var(--top) * 4) 0;
		}
	}
</style>
