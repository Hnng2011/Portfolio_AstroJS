---
import { experiences } from '../data/portfolio';

const roleCount = String(experiences.length).padStart(2, '0');
---

<section id="path" class="tone-dark py-24 lg:py-32">
	<div class="swiss-container grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-6">
		<div class="lg:sticky lg:top-32 lg:col-span-4 lg:self-start">
			<div class="flex items-center gap-3">
				<span class="font-mono text-sm text-accent">05 —</span>
				<span class="t-label text-frost-dim">Work experience</span>
			</div>
			<h2 class="t-headline mt-6">
				Real <span class="stroke-title">product</span><br />teams.
			</h2>
			<p class="t-label mt-8 text-frost-dim">{roleCount} roles / 2023 → present</p>
			<div class="mt-10 flex flex-col gap-3">
				<div class="flex items-center gap-3">
					<span class="size-2.5 rounded-full bg-accent"></span>
					<span class="t-label text-frost-dim">Current</span>
				</div>
				<div class="flex items-center gap-3">
					<span class="size-2.5 rounded-full bg-white/40"></span>
					<span class="t-label text-frost-dim">Past</span>
				</div>
			</div>
		</div>

		<div class="relative lg:col-span-7 lg:col-start-6" data-timeline>
			<span
				class="absolute top-2 bottom-2 left-0 w-px bg-white/15"
				data-timeline-line
				aria-hidden="true"
			></span>
			<ol class="flex flex-col gap-8">
				{
					experiences.map((exp) => {
						const isCurrent = exp.period.includes('Present');
						return (
							<li class="group relative" data-milestone>
								<span
									class={`absolute top-8 -left-[5px] size-2.5 rounded-full transition-colors duration-300 ${
										isCurrent ? 'bg-accent' : 'bg-white/40 group-hover:bg-white/80'
									}`}
									aria-hidden="true"
								>
									{isCurrent && <span class="absolute inset-0 animate-ping rounded-full bg-accent/50" />}
								</span>
								<article class="glass-dark glass-edge glass-hover rounded-glass ml-8 p-6 hover:-translate-y-1 hover:border-white/30">
									<p class="t-label text-frost-dim">{exp.period}</p>
									<h3 class="mt-3 text-2xl font-black tracking-tight uppercase text-frost">{exp.role}</h3>
									<p class="mt-1 font-mono text-sm text-accent-soft">{exp.company}</p>
									<p class="mt-4 text-sm leading-relaxed text-frost-dim">{exp.detail}</p>
								</article>
							</li>
						);
					})
				}
			</ol>
		</div>
	</div>
</section>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const section = document.querySelector('#path');

	if (section) {
		const track = section.querySelector('[data-timeline]');
		const line = section.querySelector('[data-timeline-line]');
		const milestones = gsap.utils.toArray('[data-milestone]', section);

		if (reduceMotion) {
			gsap.set(milestones, { opacity: 1, clearProps: 'transform' });
			if (line) gsap.set(line, { clearProps: 'transform' });
		} else {
			if (line && track) {
				gsap.fromTo(line, { scaleY: 0 }, {
					scaleY: 1,
					ease: 'none',
					transformOrigin: 'top center',
					scrollTrigger: { trigger: track, start: 'top 75%', end: 'bottom 80%', scrub: 0.6 },
				});
			}

			milestones.forEach((milestone) => {
				gsap.fromTo(
					milestone,
					{ opacity: 0, x: 40, y: 24 },
					{
						opacity: 1,
						x: 0,
						y: 0,
						duration: 1,
						ease: 'power4.out',
						scrollTrigger: { trigger: milestone, start: 'top 80%', once: true },
					}
				);
			});
		}
	}
</script>
