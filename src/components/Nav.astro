---
import { navLinks, contactLinks, profile } from '../data/portfolio';
---

<header id="nav" class="fixed inset-x-0 top-0 z-80">
	<div class="reel-container flex items-center justify-between py-5">
		<a href="#top" class="group flex items-baseline gap-2" aria-label="Back to top">
			<span class="font-display text-lg tracking-tight text-bone uppercase">Phi Hung</span>
			<span class="h-1.5 w-1.5 bg-flame transition-transform duration-500 group-hover:scale-150"></span>
		</a>
		<div class="flex items-center gap-6">
			<span class="t-mono hidden text-ash md:block" data-timecode>00:00:00:00</span>
			<button
				type="button"
				data-menu-toggle
				class="t-mono flex items-center gap-3 border border-bone/20 px-4 py-2.5 text-bone transition-colors duration-300 hover:border-flame hover:text-flame"
				aria-expanded="false"
				aria-controls="overlay-menu"
			>
				<span data-menu-label>Menu</span>
				<span class="relative block h-2.5 w-4" aria-hidden="true">
					<i class="menu-line absolute inset-x-0 top-0 h-px bg-current"></i>
					<i class="menu-line absolute inset-x-0 bottom-0 h-px bg-current"></i>
				</span>
			</button>
		</div>
	</div>
</header>

<div id="overlay-menu" class="fixed inset-0 z-70 hidden" aria-hidden="true">
	<div class="absolute inset-0 bg-void/95 backdrop-blur-xl" data-menu-bg></div>
	<div class="layer-grid absolute inset-0"></div>
	<nav class="reel-container relative flex h-full flex-col justify-center gap-2 py-24" aria-label="Overlay">
		{navLinks.map((l, i) => (
			<a href={l.href} data-menu-link class="group flex items-baseline gap-5 py-1" style={`--i:${i}`}>
				<span class="t-mono text-flame">0{i + 1}</span>
				<span class="t-title text-bone transition-colors duration-300 group-hover:text-flame">
					{l.label}
				</span>
				<span class="ml-auto h-px w-0 bg-flame transition-all duration-500 group-hover:w-16"></span>
			</a>
		))}
		<div class="mt-10 flex flex-wrap gap-6 border-t border-bone/10 pt-8" data-menu-foot>
			{contactLinks.map((c) => (
				<a href={c.url} target={c.url.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" class="t-mono text-ash transition-colors hover:text-flame">
					{c.label} ↗
				</a>
			))}
			<span class="t-mono ml-auto text-dim">{profile.location} — {profile.stack}</span>
		</div>
	</nav>
</div>

<div class="pointer-events-none fixed bottom-5 left-5 z-60 hidden md:block" aria-hidden="true">
	<p class="t-mono text-dim"><span data-progress>000</span>% — scroll</p>
</div>
<div class="pointer-events-none fixed right-5 bottom-5 z-60 hidden md:block" aria-hidden="true">
	<p class="t-mono text-dim">Reel 2026 / 10.8°N 106.7°E</p>
</div>

<nav class="chapter-rail" aria-label="Chapters">
	<a href="#top" data-chapter="top"><span>01 Intro</span><i></i></a>
	<a href="#work" data-chapter="work"><span>02 Work</span><i></i></a>
	<a href="#stack" data-chapter="stack"><span>03 Stack</span><i></i></a>
	<a href="#lab" data-chapter="lab"><span>04 Lab</span><i></i></a>
	<a href="#path" data-chapter="path"><span>05 Path</span><i></i></a>
	<a href="#contact" data-chapter="contact"><span>06 Contact</span><i></i></a>
</nav>

<style>
	#nav {
		transition: transform 0.6s var(--ease-reel), background-color 0.4s;
	}

	#nav.is-hidden {
		transform: translateY(-110%);
	}

	#nav.is-solid {
		background: color-mix(in srgb, var(--color-void) 78%, transparent);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid rgb(236 232 223 / 0.06);
	}

	#nav.nav-intro {
		animation: nav-in 1s var(--ease-reel) 2.2s backwards;
	}

	@keyframes nav-in {
		from {
			transform: translateY(-60px);
			opacity: 0;
		}

		to {
			transform: none;
			opacity: 1;
		}
	}

	.menu-line {
		transition: transform 0.4s var(--ease-reel);
	}

	[data-menu-toggle][aria-expanded='true'] .menu-line:first-child {
		transform: translateY(4.5px) rotate(45deg);
	}

	[data-menu-toggle][aria-expanded='true'] .menu-line:last-child {
		transform: translateY(-4.5px) rotate(-45deg);
	}
</style>

<script>
	import { gsap, ScrollTrigger, initLenis, timecode, reduced } from '../lib/motion';

	initLenis();

	const nav = document.querySelector('#nav')!;
	const toggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement;
	const overlay = document.querySelector('#overlay-menu') as HTMLElement;
	const links = overlay.querySelectorAll('[data-menu-link]');
	const foot = overlay.querySelector('[data-menu-foot]')!;
	const label = document.querySelector('[data-menu-label]')!;

	let open = false;
	const setOpen = (next: boolean) => {
		open = next;
		toggle.setAttribute('aria-expanded', String(open));
		label.textContent = open ? 'Close' : 'Menu';
		overlay.setAttribute('aria-hidden', String(!open));
		if (open) {
			overlay.classList.remove('hidden');
			gsap.timeline()
				.fromTo(overlay, { opacity: 0 }, { opacity: 1, duration: 0.4 })
				.fromTo(
					links,
					{ y: 60, opacity: 0 },
					{ y: 0, opacity: 1, duration: 0.7, stagger: 0.07, ease: 'power3.out' },
					0.1,
				)
				.fromTo(foot, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.6 }, 0.35);
		} else {
			gsap.to(overlay, {
				opacity: 0,
				duration: 0.35,
				onComplete: () => overlay.classList.add('hidden'),
			});
		}
	};

	toggle.addEventListener('click', () => setOpen(!open));
	links.forEach((l) => l.addEventListener('click', () => setOpen(false)));
	document.addEventListener('keydown', (e) => e.key === 'Escape' && open && setOpen(false));

	let lastY = 0;
	ScrollTrigger.create({
		start: 0,
		end: 'max',
		onUpdate: (self) => {
			const y = self.scroll();
			nav.classList.toggle('is-solid', y > 40);
			if (!open) nav.classList.toggle('is-hidden', y > lastY && y > 400);
			lastY = y;
			const tc = document.querySelector('[data-timecode]');
			const pr = document.querySelector('[data-progress]');
			if (tc) tc.textContent = timecode(self.progress);
			if (pr) pr.textContent = String(Math.round(self.progress * 100)).padStart(3, '0');
			syncChapter(y);
		},
	});

	if (!reduced) {
		nav.classList.add('nav-intro');
	}

	const chapters = document.querySelectorAll('[data-chapter]');
	const chapterIds = ['top', 'work', 'stack', 'lab', 'path', 'contact'];
	const chapterEls = chapterIds
		.map((id) => document.getElementById(id))
		.filter(Boolean) as HTMLElement[];
	let activeChapter = '';
	const setActive = (id: string) => {
		if (id === activeChapter) return;
		activeChapter = id;
		chapters.forEach((c) => c.classList.toggle('is-active', c.getAttribute('data-chapter') === id));
	};
	const syncChapter = (scrollY: number) => {
		const mid = scrollY + innerHeight * 0.5;
		let cur = chapterIds[0];
		for (const el of chapterEls) {
			if (el.offsetTop <= mid) cur = el.id;
		}
		setActive(cur);
	};
	syncChapter(0);

	document.querySelectorAll('[data-divider]').forEach((d) => {
		gsap.to(d.querySelector('i'), {
			scaleX: 1,
			ease: 'none',
			scrollTrigger: { trigger: d, start: 'top 92%', end: 'top 45%', scrub: 0.5 },
		});
	});
</script>
